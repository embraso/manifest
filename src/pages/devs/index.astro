---
import SiteLayout from '../../layouts/SiteLayout.astro';
import TerminalHome from '../../components/devs/TerminalHome.astro';
import CommandCarousel from '../../components/devs/command-carousel/CommandCarousel.astro';
import { defaultLocale, getMessages } from '../../i18n';

const locale = defaultLocale;
const messages = getMessages(locale);
---

<SiteLayout audience="devs" locale={locale} title={messages.shell.metadata.devsTitle} description={messages.shell.metadata.devsDescription}>
  <TerminalHome locale={locale}>
    <CommandCarousel locale={locale} slot="reader" />
  </TerminalHome>
</SiteLayout>

<script>
  import '../../scripts/motion';
</script>
