---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { introduction, principles, invitation } from '../../data/manifesto';
import toucan from '../../../assets/18b51d99adf971345c6d3e2da4ff6e2c.svg';
---

<SiteLayout title="Manifesto — Embraso" isManifesto>
  <main id="conteudo" class="manifesto-page container">
    <a class="back-link" href="/">← Voltar ao início</a>
    <header class="manifesto-header">
      <h1>Manifesto</h1>
      <img src={toucan.src} alt="" width="236" height="104" />
    </header>
    <article class="manifesto-copy" aria-label="Manifesto Embraso">
      <div class="manifesto-intro">
        <h2>Liberdade se constrói junto.</h2>
        {introduction.map((paragraph) => <p>{paragraph}</p>)}
      </div>
      <ol class="principles">
        {principles.map((principle) => (
          <li>
            <section>
              <h2>{principle.title}</h2>
              <p class="principle-lead">{principle.lead}</p>
              <p>{principle.body}</p>
            </section>
          </li>
        ))}
      </ol>
      <section class="manifesto-invitation">
        <h2>Um convite para construir</h2>
        <p>{invitation.introduction}</p>
        <p>{invitation.body}</p>
        <p class="invitation-closing">{invitation.closing}</p>
        <a class="button" href="/#participacao">Conheça as formas de contribuir <span aria-hidden="true">→</span></a>
      </section>
    </article>
  </main>
</SiteLayout>

<style>
  .manifesto-page { max-width: 1000px; padding-block: 45px 100px; }
  .back-link { font-size: 13px; }
  .manifesto-header { display: flex; align-items: center; justify-content: space-between; gap: 20px; padding: 35px 0 30px; border-bottom: 3px solid var(--green); }
  .manifesto-header h1 { margin: 0; font-size: clamp(3rem, 9vw, 6rem); line-height: 1; font-weight: 900; font-stretch: 65%; text-transform: uppercase; letter-spacing: -.035em; }
  .manifesto-header img { width: min(24%, 180px); }
  .manifesto-copy { max-width: 740px; margin-inline: auto; font-size: 17px; }
  .manifesto-intro { padding-block: 50px 24px; }
  .manifesto-copy h2 { font-size: clamp(1.45rem, 3.5vw, 2rem); line-height: 1.2; font-weight: 800; letter-spacing: -.025em; margin-bottom: 22px; }
  .manifesto-intro h2 { font-size: clamp(2rem, 5vw, 3.2rem); }
  .manifesto-copy p { margin-bottom: 22px; }
  .principles { list-style: none; padding: 0; margin: 0; counter-reset: principles; }
  .principles li { counter-increment: principles; padding-block: 38px 20px; border-top: 1px solid #abb9a3; }
  .principles h2::before { content: counter(principles) '. '; color: #a74e12; }
  .principle-lead { font-weight: 700; }
  .manifesto-invitation { margin-top: 24px; border-top: 3px solid var(--green); padding-top: 40px; }
  .invitation-closing { font-weight: 800; font-size: 23px; line-height: 1.3; }
  .manifesto-invitation .button { margin-top: 10px; }
  @media (max-width: 700px) {
    .manifesto-page { padding-block: 28px 65px; }
    .manifesto-copy { font-size: 16px; }
    .manifesto-header { padding-block: 28px 22px; }
    .manifesto-intro { padding-top: 35px; }
  }
</style>
