---
import SiteLayout from '../layouts/SiteLayout.astro';
import FolhetoHome from '../components/folheto/FolhetoHome.astro';
import { defaultLocale, getMessages } from '../i18n';

const locale = defaultLocale;
const messages = getMessages(locale);
---

<SiteLayout audience="public" locale={locale} title={messages.shell.metadata.publicTitle}>
  <FolhetoHome locale={locale} />
</SiteLayout>

<script>
  import '../scripts/motion';
</script>

