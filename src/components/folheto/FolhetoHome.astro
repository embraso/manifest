---
import { getMessages, type Locale } from '../../i18n';
import capybara from '../../../assets/64e6db346ad8c01e777f7cf3f3a36383.svg';
import Scene from './Scene.astro';
import BrandWordmark from '../brand/BrandWordmark.astro';
import BrazilFlag from '../brand/BrazilFlag.astro';

interface Props { locale: Locale }
const { locale } = Astro.props;
const messages = getMessages(locale);
const signatureLines: Exclude<typeof messages.shell.signature[number], { type: 'break' }>[][] = [[]];
for (const part of messages.shell.signature) {
  if (part.type === 'break') signatureLines.push([]);
  else signatureLines[signatureLines.length - 1]!.push(part);
}
const motivations = messages.home.motivations.options;
const contributions = messages.home.participation.contributions;
---

<main id="conteudo" class="folheto" data-folheto>
  <section class="opening" aria-labelledby="folheto-title">
    <div class="opening-copy page-wrap">
      <h1 id="folheto-title">{signatureLines.map((line) => <span class={line.some((part) => part.type === 'accent' || part.type === 'mark') ? 'together' : undefined}>{line.map((part) => part.type === 'accent' || part.type === 'mark' ? <mark>{part.text}</mark> : part.type === 'strong' ? <strong>{part.text}</strong> : part.type === 'emphasis' ? <span>{part.text}</span> : part.text)}{' '}</span>)}</h1>
      <p class="opening-intro">{messages.home.opening.intro.map((part) => part.type === 'break' ? <br /> : part.type === 'strong' ? <strong>{part.text}</strong> : part.type === 'emphasis' ? <span>{part.text}</span> : part.type === 'accent' || part.type === 'mark' ? <mark>{part.text}</mark> : part.text)}</p>
      <div class="opening-actions">
        <a class="button" href="/manifesto/">{messages.home.opening.manifestoLink} <span class="reading-arrow" aria-hidden="true"></span></a>
        <a class="text-link" href="#participacao">{messages.home.opening.participationLink}</a>
      </div>
    </div>
    <Scene />
  </section>

  <section id="proposta" class="proposal page-wrap" aria-labelledby="proposal-title">
    <h2 id="proposal-title">{messages.home.proposal.heading.map((part) => part.type === 'break' ? <br /> : part.type === 'emphasis' ? <span>{part.text}</span> : part.type === 'strong' ? <strong>{part.text}</strong> : part.type === 'mark' || part.type === 'accent' ? <mark>{part.text}</mark> : part.text)}</h2>
    <p class="large-reading">{messages.home.proposal.lead}</p>
    <div class="proposal-reading">
      {[
        { title: messages.home.proposal.aboutTitle, body: messages.home.proposal.about },
        { title: messages.home.proposal.communityTitle, body: messages.home.proposal.community },
        { title: messages.home.proposal.autonomyTitle, body: messages.home.proposal.autonomy },
      ].map(({ title, body }) => <article><h3>{title}</h3><p>{body}</p></article>)}
    </div>
  </section>

  <section class="motivations" aria-labelledby="motivations-title" data-motivation-reader>
    <div class="page-wrap">
      <div class="motivations-heading">
        <div><h2 id="motivations-title">{messages.home.motivations.title.map((part) => part.type === 'break' ? <br /> : part.type === 'emphasis' ? <BrandWordmark light /> : part.type === 'strong' ? <strong>{part.text}</strong> : part.type === 'mark' || part.type === 'accent' ? <mark>{part.text}</mark> : part.text)}</h2><p>{messages.home.motivations.intro}</p></div>
        <div class="motivation-flag" aria-hidden="true"><BrazilFlag /></div>
      </div>
      <fieldset class="motivation-controls" data-motivation-controls hidden>
        <legend>{messages.home.motivations.chooser}</legend>
        <div class="motivation-options">
          {motivations.map((motivation, index) => <label for={`motivation-choice-${motivation.id}`}><input id={`motivation-choice-${motivation.id}`} type="radio" name="motivation" value={motivation.id} checked={index === 0} aria-controls={`motivation-reading-${motivation.id}`} /><span>{motivation.title}</span></label>)}
        </div>
      </fieldset>
      <p class="motivation-status" role="status" aria-live="polite" aria-atomic="true" data-motivation-status data-status-template={messages.home.motivations.status} hidden></p>
      <div class="motivation-pages">
        {motivations.map((motivation, index) => (
          <article class="motivation-page" id={`motivation-reading-${motivation.id}`} data-motivation-page={motivation.id} aria-labelledby={`motivation-heading-${motivation.id}`}>
            <div class="motivation-title"><h3 id={`motivation-heading-${motivation.id}`}>{motivation.title}</h3><p>{motivation.question}</p></div>
            <div class="motivation-reading">
              <p><strong>{messages.home.motivations.problemLabel}</strong>{motivation.problem}</p>
              {index === 0 && <p class="motivation-source"><a href={messages.home.motivations.source.href}>{messages.home.motivations.source.label} <span aria-hidden="true">↗</span></a></p>}
              <p><strong>{messages.home.motivations.approachLabel}</strong>{motivation.approach}</p>
            </div>
          </article>
        ))}
      </div>
      <p class="motivation-footnote">{messages.home.motivations.footnote}</p>
      <noscript><p class="no-script-note">{messages.home.motivations.noScript}</p></noscript>
    </div>
  </section>

  <section id="manifesto" class="manifesto page-wrap" aria-labelledby="manifesto-title">
    <div class="manifesto-opening"><h2 id="manifesto-title">{messages.home.manifesto.heading.map((part) => part.type === 'break' ? <br /> : part.type === 'emphasis' ? <span>{part.text}</span> : part.type === 'strong' ? <strong>{part.text}</strong> : part.type === 'mark' || part.type === 'accent' ? <mark>{part.text}</mark> : part.text)}</h2><p>{messages.home.manifesto.description}</p><a class="text-link" href="/manifesto/">{messages.home.manifesto.link} <span class="reading-arrow" aria-hidden="true"></span></a></div>
    <ol class="principles">{messages.manifesto.principles.map((principle, index) => (
      <li class="principle"><span class="principle-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span><h3>{principle.title}</h3></li>
    ))}</ol>
  </section>

  <section id="participacao" class="participation" aria-labelledby="participation-title">
    <div class="page-wrap">
      <div class="participation-opening"><h2 id="participation-title">{messages.home.participation.heading.map((part) => part.type === 'break' ? <br /> : part.type === 'emphasis' ? <span>{part.text}</span> : part.type === 'strong' ? <strong>{part.text}</strong> : part.type === 'mark' || part.type === 'accent' ? <mark>{part.text}</mark> : part.text)}</h2><div><p>{messages.home.participation.intro}</p><p>{messages.home.participation.context}</p></div></div>
      <dl class="contributions">{contributions.map(([title, body]) => <div><dt>{title}</dt><dd>{body}</dd></div>)}</dl>
      <div class="participation-note"><strong>{messages.home.participation.noteLead}</strong><p>{messages.home.participation.note}</p></div>
      <a class="button learning-link" href="#ideia" data-idea-link>{messages.home.participation.learningLink} <span class="reading-arrow" aria-hidden="true"></span></a>
    </div>
    <img class="participation-capybara" src={capybara.src} alt="" width="352" height="192" loading="lazy" />
  </section>

  <section id="ideia" class="closing page-wrap" aria-labelledby="closing-title">
    <div class="closing-heading"><h2 id="closing-title">{messages.home.closing.heading.map((part) => part.type === 'break' ? <br /> : part.type === 'emphasis' ? <span>{part.text}</span> : part.type === 'strong' ? <strong>{part.text}</strong> : part.type === 'mark' || part.type === 'accent' ? <mark>{part.text}</mark> : part.text)}</h2></div>
    <div class="closing-reading"><p>{messages.home.closing.reading}</p><form class="closing-idea-form">
      <label for="folheto-idea">{messages.home.closing.form.label}</label>
      <textarea id="folheto-idea" name="idea" rows="4" placeholder={messages.home.closing.form.placeholder} aria-describedby="folheto-idea-privacy folheto-idea-status"></textarea>
      <p id="folheto-idea-privacy" class="closing-form-note">{messages.home.closing.form.privacyNote}</p>
      <p id="folheto-idea-status" class="closing-form-note">{messages.home.closing.form.status}</p>
      <button class="button" type="button" disabled>{messages.home.closing.form.submit}</button>
    </form></div>
  </section>
</main>

<script>
  import './motivation-reader';
</script>
<script>
  import '../../scripts/participation';
</script>

<style>
  .folheto { color: var(--green); background: var(--paper); overflow-wrap: break-word; font-size: 1.0625rem; line-height: 1.7; }
  .page-wrap { width: min(1200px, calc(100% - 80px)); margin-inline: auto; }
  .folheto :is(h1, h2, h3, p, dl, dd) { margin: 0; }
  .folheto :is(h1, h2) { font-family: var(--font-display); font-stretch: 72%; font-weight: 800; text-transform: uppercase; letter-spacing: -.02em; line-height: 1.05; }
  .folheto h2 { font-size: clamp(2.6rem, 5vw, 4.6rem); }
  .folheto a { text-underline-offset: .25em; }
  .reading-arrow { display: inline-block; position: relative; width: 16px; height: 13px; margin-left: 4px; vertical-align: middle; flex: 0 0 auto; }
  .reading-arrow::before { content: ''; position: absolute; width: 15px; height: 1px; background: currentColor; left: 0; top: 6px; }
  .reading-arrow::after { content: ''; position: absolute; width: 8px; height: 8px; border-top: 1px solid currentColor; border-right: 1px solid currentColor; transform: rotate(45deg); right: 1px; top: 2px; }
  .folheto :is(a, input, textarea, button):focus-visible { outline: 3px solid var(--blue); outline-offset: 5px; }
  .folheto [hidden] { display: none !important; }
  .opening { position: relative; padding-top: clamp(36px, 4.5vw, 68px); background: linear-gradient(180deg, var(--paper) 0%, #fff2d9 75%, #fce2b7 100%); }
  .opening-copy { position: relative; z-index: 1; text-align: center; }
  .opening h1 { max-width: 1060px; margin-inline: auto; font-size: clamp(4rem, 7.5vw, 6rem); line-height: .99; font-stretch: 65%; }
  .opening h1 > span { display: inline; }
  .opening h1 > span:first-child { display: block; margin-bottom: .08em; }
  .opening mark { position: relative; isolation: isolate; color: var(--green); background: none; padding-inline: .035em .08em; white-space: nowrap; }
  .opening mark::before { content: ''; position: absolute; z-index: -1; inset: 17% 0 -1%; background: var(--yellow); transform: rotate(-2deg); }
  .opening-intro { font-size: clamp(1.125rem, 1.6vw, 1.35rem); line-height: 1.6; max-width: 58ch; margin: 26px auto 0 !important; }
  .opening-actions { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 18px 30px; margin-top: 26px; }
  .opening-actions .text-link { font-size: 1rem; }
  .proposal { padding-block: 64px 72px; }
  .proposal h2 { font-size: clamp(2.4rem, 4.6vw, 4.2rem); margin-bottom: 24px; }
  .proposal h2 span { color: #76501b; }
  .large-reading { font-size: clamp(1.25rem, 1.8vw, 1.5rem); line-height: 1.55; max-width: 64ch; margin-bottom: 30px !important; }
  .proposal-reading { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 30px; }
  .proposal-reading article { border-top: 4px solid #83966c; padding-top: 18px; }
  .proposal-reading article:nth-child(2) { border-color: var(--green); }
  .proposal-reading article:nth-child(3) { border-color: var(--orange); }
  .proposal-reading h3 { font-size: 1.65rem; font-stretch: 85%; line-height: 1.2; margin-bottom: 14px; }
  .proposal-reading article:nth-child(3) h3 { color: #8c410f; }
  .proposal-reading p { font-size: 1rem; line-height: 1.7; }
  .motivations { background: var(--green); color: var(--cream); padding-block: 58px 38px; }
  .motivations-heading { display: grid; grid-template-columns: minmax(0, 1fr) 300px; align-items: center; gap: 48px; margin-bottom: 28px; }
  .motivations-heading h2 { font-size: clamp(2.5rem, 4.6vw, 4.4rem); }
  .motivations-heading h2 :global(.brand-wordmark) { font-size: .85em; margin-inline: .02em; vertical-align: -.025em; }
  .motivations-heading p { margin-top: 18px; max-width: 65ch; font-size: 1rem; }
  .motivation-flag { width: 100%; transform: rotate(5deg); }
  .motivation-controls { border: 0; padding: 0; margin: 0; min-width: 0; }
  .motivation-controls legend { font-size: 13px; margin-bottom: 10px; }
  .motivation-options { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-top: 1px solid #91b095; }
  .motivation-options label { cursor: pointer; display: flex; align-items: center; justify-content: start; gap: 12px; min-height: 54px; padding: 12px 16px; font-size: 1.125rem; font-stretch: 85%; font-weight: 650; line-height: 1.3; border-bottom: 1px solid #91b095; transition: background-color 150ms; }
  .motivation-options label:not(:nth-child(3n + 1)) { border-left: 1px solid #91b095; }
  .motivation-options label > span { min-width: 0; }
  .motivation-options label:has(input:checked) { background: var(--yellow); color: var(--dark); }
  .motivation-options label:hover { background: #32694a; }
  .motivation-options label:has(input:checked):hover { background: var(--yellow); }
  .motivation-options input { appearance: none; display: grid; place-content: center; width: 18px; height: 18px; margin: 0; flex: 0 0 18px; border: 2px solid currentColor; border-radius: 50%; background: transparent; color: inherit; }
  .motivation-options input::before { content: ''; width: 8px; height: 8px; border-radius: 50%; background: currentColor; transform: scale(0); }
  .motivation-options input:checked::before { transform: scale(1); }
  .motivation-options label:focus-within { outline: 3px solid var(--yellow); outline-offset: 3px; position: relative; z-index: 1; }
  .motivation-options input:focus-visible { outline-color: var(--blue); outline-offset: 3px; }
  .motivation-status { padding-top: 14px; font-size: 12px; color: var(--yellow); }
  .motivation-page { display: grid; grid-template-columns: .8fr 1.2fr; gap: 7%; padding-block: 28px; border-bottom: 1px solid #719479; }
  .motivation-title h3 { font-stretch: 72%; font-size: clamp(2.1rem, 4vw, 3.5rem); font-weight: 800; letter-spacing: -.02em; line-height: 1.1; }
  .motivation-title p { margin-top: 16px; font-size: clamp(1.2rem, 1.7vw, 1.5rem); line-height: 1.5; max-width: 30ch; color: var(--yellow); }
  .motivation-reading { font-size: 1rem; }
  .motivation-reading p + p { margin-top: 18px; }
  .motivation-reading strong { display: block; margin-bottom: 6px; }
  .motivation-reading .motivation-source { margin-top: 8px; font-size: 12px; line-height: 1.5; }
  .motivation-source a:hover { color: var(--yellow); }
  .motivation-footnote { max-width: 95ch; margin-top: 22px !important; font-size: 13px; line-height: 1.6; }
  .no-script-note { margin-top: 16px !important; font-size: 14px; }
  .manifesto { display: grid; grid-template-columns: .8fr 1.2fr; gap: 8%; align-items: center; padding-block: 68px; }
  .manifesto-opening h2 { font-size: clamp(2.7rem, 4.2vw, 4rem); }
  .manifesto-opening p { margin-block: 22px; max-width: 38ch; font-size: 1rem; }
  .manifesto-opening a { font-size: 1rem; }
  .principles { list-style: none; padding: 0; margin: 0; }
  .principle { display: grid; grid-template-columns: 28px minmax(0, 1fr); align-items: baseline; gap: 16px; padding-block: 16px; border-top: 1px solid #a1b09a; }
  .principle:last-child { border-bottom: 1px solid #a1b09a; }
  .principle-number { color: #8c410f; font-family: var(--font-mono); font-size: 12px; font-variant-numeric: tabular-nums; }
  .principle h3 { font-size: clamp(1.1rem, 1.8vw, 1.4rem); font-stretch: 85%; font-weight: 650; line-height: 1.35; }
  .participation { position: relative; background: var(--yellow); padding-block: 56px 88px; color: var(--dark); }
  .participation ::selection { background: var(--dark); color: var(--cream); }
  .participation-opening { display: grid; grid-template-columns: 1fr 1fr; gap: 8%; align-items: start; margin-bottom: 30px; }
  .participation-opening h2 { font-size: clamp(2.4rem, 4.3vw, 4rem); }
  .participation-opening p { font-size: 1rem; }
  .participation-opening p + p { margin-top: 14px; }
  .contributions { display: grid; grid-template-columns: 1fr 1fr; gap: 0 40px; }
  .contributions > div { border-top: 1px solid #8f6b20; padding-block: 20px; }
  .contributions dt { margin-bottom: 8px; font-size: 1.3rem; font-stretch: 85%; font-weight: 700; line-height: 1.3; }
  .contributions dd { max-width: 58ch; font-size: 1rem; }
  .participation-note { display: grid; grid-template-columns: .7fr 1.3fr; gap: 40px; margin-top: 8px; padding-top: 22px; border-top: 1px solid #8f6b20; font-size: .9375rem; }
  .participation-note strong { font-size: 1.125rem; line-height: 1.5; }
  .participation-capybara { position: absolute; width: 150px; right: max(20px, calc((100vw - 1200px) / 2)); bottom: 0; pointer-events: none; }
  .learning-link { margin-top: 24px; }
  .closing { display: grid; grid-template-columns: 1fr 1fr; align-items: start; position: relative; gap: 7%; padding-block: 68px; scroll-margin-top: 24px; }
  .closing h2 { font-size: clamp(2.9rem, 5.3vw, 4.7rem); }
  .closing h2 span { text-decoration: underline; text-decoration-color: var(--yellow); text-decoration-thickness: .1em; text-underline-offset: .04em; }
  .closing-reading { min-width: 0; }
  .closing-reading > p { max-width: 48ch; }
  .closing-idea-form { display: grid; justify-items: start; gap: 10px; margin-top: 24px; }
  .closing-idea-form label { font-size: .9375rem; font-weight: 700; }
  .closing-idea-form textarea { display: block; width: 100%; min-height: 136px; padding: 14px 16px; border: 1px solid #6d856b; border-radius: 0; background: var(--cream); color: var(--dark); resize: vertical; font-size: 1rem; line-height: 1.6; scroll-margin-block: 28px; }
  .closing-idea-form textarea::placeholder { color: #52684f; opacity: 1; }
  .closing-form-note { font-size: 12px; line-height: 1.5; }
  .closing-idea-form .button { min-height: 42px; padding: 10px 16px; font-size: 14px; }
  @media (max-width: 1000px) {
    .page-wrap { width: calc(100% - 48px); }
    .proposal-reading { grid-template-columns: 1fr; gap: 26px; }
    .large-reading { max-width: 60ch; }
    .motivations-heading { grid-template-columns: minmax(0, 1fr) 240px; gap: 32px; }
    .manifesto { gap: 36px; }
    .closing h2 { font-size: clamp(2.5rem, 5.5vw, 4rem); }
  }
  @media (max-width: 700px) {
    .page-wrap { width: calc(100% - 40px); }
    .opening { padding-top: 36px; }
    .opening h1 { font-size: clamp(2.65rem, 12vw, 4.6rem); line-height: 1.02; }
    .opening-intro { max-width: 43ch; margin-top: 24px !important; font-size: 1.125rem; }
    .opening-actions { gap: 20px; margin-top: 24px; }
    .opening-actions .button { padding-inline: 18px; }
    .opening-actions .text-link { padding-block: 8px; }
    .proposal { padding-block: 42px 46px; }
    .proposal h2 { font-size: clamp(2.05rem, 8.5vw, 3.5rem); margin-bottom: 22px; }
    .large-reading { font-size: 1.3rem; }
    .proposal-reading h3 { font-size: 1.5rem; }
    .motivations { padding-block: 38px 30px; }
    .motivations-heading { grid-template-columns: minmax(0, 1fr); gap: 22px; }
    .motivations-heading h2 { font-size: clamp(2.2rem, 8.7vw, 3.7rem); }
    .motivations-heading p { margin-top: 18px; max-width: 43ch; }
    .motivation-flag { width: clamp(200px, 60vw, 240px); margin-left: auto; margin-right: 12px; transform: rotate(4deg); }
    .motivation-options { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .motivation-options label { min-height: 52px; font-size: 1rem; gap: 8px; padding-inline: 10px; }
    .motivation-options label:nth-child(n) { border-left: 0; }
    .motivation-options label:nth-child(2n) { border-left: 1px solid #91b095; }
    .motivation-page { display: block; padding-block: 24px; }
    .motivation-title h3 { font-size: 2.2rem; }
    .motivation-title p { font-size: 1.25rem; margin-top: 12px; max-width: 34ch; }
    .motivation-reading { margin-top: 22px; }
    .manifesto { grid-template-columns: minmax(0, 1fr); padding-block: 46px; gap: 28px; }
    .manifesto-opening h2 { font-size: 2.8rem; }
    .manifesto-opening p { max-width: 45ch; margin-block: 20px; }
    .principle { gap: 12px; padding-block: 15px; }
    .participation { padding-block: 42px 84px; }
    .participation-opening { grid-template-columns: minmax(0, 1fr); gap: 22px; margin-bottom: 24px; }
    .participation-opening h2 { font-size: clamp(2.4rem, 9vw, 3.4rem); }
    .contributions { grid-template-columns: minmax(0, 1fr); }
    .contributions > div { padding-block: 17px; }
    .contributions dt { font-size: 1.2rem; }
    .participation-note { grid-template-columns: minmax(0, 1fr); gap: 10px; margin-top: 6px; padding-top: 20px; }
    .participation-capybara { width: 116px; }
    .learning-link { width: 100%; gap: 12px; padding-inline: 14px; font-size: .9375rem; }
    .closing { grid-template-columns: minmax(0, 1fr); gap: 24px; padding-block: 42px; }
    .closing h2 { font-size: clamp(2.7rem, 10.5vw, 4rem); }
    .closing-reading { max-width: 47ch; }
  }
  @media (max-width: 380px) {
    .page-wrap { width: calc(100% - 32px); }
    .opening-actions { flex-direction: column; gap: 10px; }
    .opening-actions .button, .closing-idea-form .button { width: 100%; }
    .motivation-options label { font-size: .9375rem; padding-inline: 8px; }
  }
  @media (forced-colors: active) {
    .motivation-options input { appearance: auto; border: revert; background: revert; color: CanvasText; accent-color: auto; }
    .motivation-options input::before { content: none; }
    .motivation-options label:has(input:checked), .motivation-options label:has(input:checked):hover { background: Highlight; color: HighlightText; }
    .motivation-options label:focus-within { outline-color: Highlight; }
    .motivation-options input:focus-visible { outline-color: CanvasText; }
  }
  @media print {
    .motivation-controls, .motivation-status { display: none; }
    .folheto .motivation-page[hidden] { display: grid !important; }
    .motivations, .participation { background: transparent; color: black; }
    .motivation-title p, .motivation-status { color: black; }
    .closing-idea-form { display: none; }
  }
</style>
