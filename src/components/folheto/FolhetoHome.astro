---
import { principles } from '../../data/manifesto';
import capybara from '../../../assets/64e6db346ad8c01e777f7cf3f3a36383.svg';
import Scene from './Scene.astro';

const freedoms = [
  {
    id: 'usar',
    title: 'Usar',
    lead: 'A ferramenta serve à sua vida. Não o contrário.',
    body: 'Software livre permite usar um programa para qualquer finalidade, inclusive no trabalho e em atividades comerciais. Sua liberdade não depende de pedir uma nova autorização a cada uso.',
    example: 'Um coletivo cultural pode usar a mesma ferramenta que um pequeno negócio. A finalidade muda; a liberdade permanece.',
    question: 'Você pode escolher para que usar essa ferramenta?',
  },
  {
    id: 'estudar',
    title: 'Estudar',
    lead: 'Entender também é uma forma de escolher.',
    body: 'Ter acesso ao código-fonte permite estudar como um programa funciona. Documentação e conhecimento compartilhado ajudam mais pessoas a compreender suas escolhas, seus limites e suas dependências.',
    example: 'Quem conhece o código pode investigar o que acontece com uma informação. Quem não programa pode aprender com uma explicação ou buscar ajuda de alguém de confiança.',
    question: 'É possível entender o que acontece por trás da tela?',
  },
  {
    id: 'modificar',
    title: 'Modificar',
    lead: 'Sua realidade não precisa caber numa ferramenta fechada.',
    body: 'Software livre permite adaptar o programa às suas necessidades. O acesso ao código-fonte é necessário para isso. Você pode fazer uma mudança ou contar com quem tenha o conhecimento para realizá-la.',
    example: 'Uma adaptação pode melhorar a navegação por teclado, uma tradução ou uma rotina de trabalho. São possibilidades, não funcionalidades já entregues pela Embraso.',
    question: 'O que precisaria mudar para funcionar melhor no seu contexto?',
  },
  {
    id: 'compartilhar',
    title: 'Compartilhar',
    lead: 'Uma melhoria pode continuar nas mãos de outras pessoas.',
    body: 'Software livre permite redistribuir cópias do programa e compartilhar versões modificadas, conforme sua licença. Assim, conhecimento e melhorias podem circular e encontrar outros caminhos de continuidade.',
    example: 'Uma solução adaptada por um grupo pode ajudar outro a não começar do zero. Compartilhar não elimina os custos de documentar, corrigir e manter.',
    question: 'Outras pessoas podem receber, adaptar e continuar o que foi feito?',
  },
];
const contributions = [
  ['Conhecer o problema', 'Contar como uma dificuldade aparece no cotidiano e o que já foi tentado. Escutar quem vive a situação vem antes de propor uma ferramenta.'],
  ['Explicar e aproximar', 'Escrever, traduzir, ensinar, pesquisar ou conectar iniciativas. Uma explicação compreensível também abre caminhos.'],
  ['Desenhar e experimentar', 'Observar o uso, apontar barreiras de acessibilidade e experimentar ideias em aparelhos e conexões diferentes.'],
  ['Programar e cuidar', 'Construir, documentar, corrigir e manter. Cuidar da continuidade é trabalho e merece reconhecimento e condições justas.'],
];
---

<main id="conteudo" class="folheto" data-folheto>
  <section class="opening page-wrap" aria-labelledby="folheto-title">
    <div class="opening-copy">
      <h1 id="folheto-title"><span>Liberdade</span><span>se constrói</span><span class="together"><mark>junto.</mark></span></h1>
      <p class="opening-intro">A Embraso é uma iniciativa para reunir pessoas e criar <strong>software útil e livre</strong>, pensado para as diferentes realidades do Brasil.</p>
      <div class="opening-actions">
        <a class="button" href="/manifesto/">Ler o manifesto <span class="reading-arrow" aria-hidden="true"></span></a>
        <a class="text-link" href="#participacao">Como participar dessa construção</a>
      </div>
    </div>
    <Scene />
  </section>

  <section id="proposta" class="proposal page-wrap" aria-labelledby="proposal-title">
    <h2 id="proposal-title">Mais do que código.<br /><span>Gente com quem construir.</span></h2>
    <div class="proposal-reading">
      <p class="large-reading">Queremos uma tecnologia que ajude a viver, não que ocupe a vida inteira. Para aprender, criar, trabalhar e organizar o que importa por aqui.</p>
      <div class="two-fronts">
        <article><h3>Comunidade.</h3><p>Aproximar quem conhece um problema de quem pode compartilhar um conhecimento. Escutar, aprender e construir com as pessoas envolvidas.</p></article>
        <article><h3>Autonomia.</h3><p>Compreender as ferramentas, poder adaptá-las e levar seus dados para outro lugar. Ter escolhas sem precisar fazer tudo por conta própria.</p></article>
      </div>
    </div>
  </section>

  <section class="freedoms" aria-labelledby="freedoms-title" data-freedom-reader>
    <div class="page-wrap">
      <div class="freedoms-heading"><h2 id="freedoms-title">Livre para quê?</h2><p>Quatro liberdades que mudam nossa relação com o software. Entenda o que cada uma permite na vida de quem usa.</p></div>
      <fieldset class="freedom-controls" data-freedom-controls hidden>
        <legend>Escolha uma liberdade para ler</legend>
        <div class="freedom-options">
          {freedoms.map((freedom, index) => <label for={`freedom-choice-${freedom.id}`}><input id={`freedom-choice-${freedom.id}`} type="radio" name="freedom" value={freedom.id} checked={index === 0} aria-controls={`freedom-reading-${freedom.id}`} /><span>{freedom.title}</span></label>)}
        </div>
      </fieldset>
      <p class="freedom-status" role="status" aria-live="polite" aria-atomic="true" data-freedom-status hidden></p>
      <div class="freedom-pages">
        {freedoms.map((freedom) => (
          <article class="freedom-page" id={`freedom-reading-${freedom.id}`} data-freedom-page={freedom.id} aria-labelledby={`freedom-heading-${freedom.id}`}>
            <div class="freedom-title"><h3 id={`freedom-heading-${freedom.id}`}>{freedom.title}</h3><p>{freedom.lead}</p></div>
            <div class="freedom-reading"><p>{freedom.body}</p><p>{freedom.example}</p><p class="freedom-question">{freedom.question}</p></div>
          </article>
        ))}
      </div>
      <p class="freedom-footnote"><strong>Livre não é o mesmo que gratuito.</strong> Essas liberdades podem conviver com atividade comercial. Cuidar delas exige recursos, manutenção e trabalho reconhecido.</p>
      <noscript><p class="no-script-note">As quatro leituras estão abertas acima. Você pode ler todas, sem ativar JavaScript.</p></noscript>
    </div>
  </section>

  <section id="manifesto" class="manifesto page-wrap" aria-labelledby="manifesto-title">
    <div class="manifesto-opening"><h2 id="manifesto-title">Uma direção.<br />Seis princípios.</h2><p>O que abrir. O que proteger. De quem depender. Quem ouvir. O manifesto orienta as escolhas difíceis — não é a obra pronta.</p><a class="text-link" href="/manifesto/">Ler o manifesto completo <span class="reading-arrow" aria-hidden="true"></span></a></div>
    <div class="principles"><p class="reading-hint">Abra os princípios para ler.</p>{principles.map((principle, index) => (
      <details class="principle" open={index === 0}>
        <summary><span class="principle-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span><h3>{principle.title}</h3><span class="disclosure-sign" aria-hidden="true"></span></summary>
        <div class="principle-reading"><p class="principle-lead">{principle.lead}</p><p>{principle.body}</p></div>
      </details>
    ))}</div>
  </section>

  <section id="participacao" class="participation" aria-labelledby="participation-title">
    <div class="page-wrap">
      <div class="participation-opening"><h2 id="participation-title">Não precisa saber<br /><span>programar.</span></h2><div><p>Quem conhece uma necessidade de perto tem algo que o código, sozinho, não sabe. Queremos reunir experiências diferentes — inclusive de quem ainda está aprendendo.</p><p>Estar no Brasil não é um requisito para se interessar. Importa ouvir quem vive cada contexto e respeitar seu tempo, seus recursos e seus caminhos.</p></div></div>
      <dl class="contributions">{contributions.map(([title, body]) => <div><dt>{title}</dt><dd>{body}</dd></div>)}</dl>
      <div class="participation-note"><strong>Interesse não é obrigação.</strong><p>Você não precisa saber tudo nem ter tempo toda semana. Colaboração não pressupõe trabalho gratuito ou disponibilidade permanente. As formas concretas de participação ainda estão sendo construídas; por enquanto, conhecer o manifesto é o caminho disponível.</p></div>
    </div>
  </section>

  <section class="closing page-wrap" aria-labelledby="closing-title">
    <img src={capybara.src} alt="" width="352" height="192" loading="lazy" />
    <div class="closing-heading"><h2 id="closing-title">Que problema<br />você conhece<br /><span>por dentro?</span></h2></div>
    <div class="closing-reading"><p>Uma boa pergunta já é um começo. Antes de propor mais um aplicativo, queremos entender o que já funciona, o que falta e o que vale construir junto.</p><p>Conheça os princípios que orientam essa iniciativa.</p><a class="button" href="/manifesto/">Comece pelo manifesto <span class="reading-arrow" aria-hidden="true"></span></a></div>
  </section>
</main>

<script>
  import './freedom-reader';
</script>

<style>
  .folheto { color: var(--green); background: var(--paper); overflow: clip; overflow-wrap: break-word; font-size: 1.0625rem; line-height: 1.75; }
  .page-wrap { width: min(1320px, calc(100% - 80px)); margin-inline: auto; }
  .folheto :is(h1, h2, h3, p, dl, dd) { margin: 0; }
  .folheto :is(h1, h2) { font-family: var(--font-display); font-stretch: 72%; font-weight: 800; text-transform: uppercase; letter-spacing: -.015em; line-height: 1.05; }
  .folheto h2 { font-size: clamp(3.2rem, 6.3vw, 6rem); }
  .folheto h2 span { color: inherit; }
  .folheto a { text-underline-offset: .25em; }
  .reading-arrow { display: inline-block; position: relative; width: 16px; height: 13px; margin-left: 4px; vertical-align: middle; flex: 0 0 auto; }
  .reading-arrow::before { content: ''; position: absolute; width: 15px; height: 1px; background: currentColor; left: 0; top: 6px; }
  .reading-arrow::after { content: ''; position: absolute; width: 8px; height: 8px; border-top: 1px solid currentColor; border-right: 1px solid currentColor; transform: rotate(45deg); right: 1px; top: 2px; }
  .folheto :is(a, summary, input):focus-visible { outline: 3px solid var(--blue); outline-offset: 6px; }
  .folheto [hidden] { display: none !important; }
  .opening { position: relative; min-height: clamp(650px, 56vw, 800px); padding-block: clamp(36px, 4vw, 64px) 68px; }
  .opening-copy { position: relative; z-index: 1; width: 56%; }
  .opening h1 { font-size: clamp(5rem, 8.2vw, 6rem); line-height: 1.02; }
  .opening h1 > span { display: block; }
  .together { margin-block: .04em .17em; }
  .opening mark { position: relative; isolation: isolate; color: var(--green); background: none; padding-inline: .035em .12em; margin-left: -.035em; }
  .opening mark::before { content: ''; position: absolute; z-index: -1; inset: 13% 0 -5%; background: var(--yellow); transform: rotate(-2deg); transform-origin: left center; }
  .opening-intro { font-size: clamp(1.125rem, 1.6vw, 1.4rem); line-height: 1.65; max-width: 42ch; margin-top: 32px !important; }
  .opening-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 24px 32px; margin-top: 32px; }
  .opening-actions .text-link { font-size: 1rem; }
  .proposal { padding-block: 76px 100px; border-top: 2px solid var(--green); }
  .proposal h2 { max-width: 1000px; margin-bottom: 46px; }
  .proposal h2 span { font-size: .78em; }
  .proposal-reading { display: grid; grid-template-columns: .8fr 1.2fr; gap: 6%; }
  .large-reading { font-size: clamp(1.3rem, 2.2vw, 1.9rem); line-height: 1.5; max-width: 27ch; }
  .two-fronts { display: grid; grid-template-columns: 1fr 1fr; gap: 32px; }
  .two-fronts h3 { font-size: 1.7rem; font-stretch: 85%; line-height: 1.25; margin-bottom: 16px; }
  .two-fronts p { line-height: 1.75; }
  .freedoms { background: var(--green); color: var(--cream); padding-block: 82px 54px; }
  .freedoms-heading { display: flex; align-items: end; gap: 40px; justify-content: space-between; margin-bottom: 42px; }
  .freedoms-heading p { max-width: 40ch; font-size: 1.0625rem; line-height: 1.75; }
  .freedom-controls { border: 0; padding: 0; margin: 0; min-width: 0; }
  .freedom-controls legend { font-size: 14px; margin-bottom: 14px; }
  .freedom-options { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); border-block: 1px solid var(--cream); }
  .freedom-options label { cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 12px; min-height: 76px; padding: 12px; font-size: clamp(1.25rem, 2.6vw, 2.1rem); font-stretch: 75%; font-weight: 750; line-height: 1.2; }
  .freedom-options label + label { border-left: 1px solid color-mix(in srgb, var(--cream) 40%, transparent); }
  .freedom-options label:has(input:checked) { background: var(--yellow); color: var(--dark); }
  .freedom-options label:hover { background: color-mix(in srgb, var(--cream) 12%, transparent); }
  .freedom-options label:has(input:checked):hover { background: var(--yellow); }
  .freedom-options input { accent-color: var(--green); width: 18px; height: 18px; margin: 0; flex: 0 0 auto; }
  .freedom-options label:focus-within { outline: 3px solid var(--yellow); outline-offset: 5px; position: relative; z-index: 1; }
  .freedom-options input:focus-visible { outline-color: var(--dark); outline-offset: 3px; }
  .freedom-status { padding-top: 18px; font-size: 13px; color: var(--yellow); }
  .freedom-page { display: grid; grid-template-columns: 1fr 1fr; gap: 8%; padding-block: 48px; border-bottom: 1px solid color-mix(in srgb, var(--cream) 35%, transparent); }
  .freedom-title h3 { font-stretch: 72%; font-size: clamp(3.4rem, 7.3vw, 6rem); font-weight: 800; letter-spacing: -.015em; line-height: 1.1; overflow-wrap: anywhere; }
  .freedom-title p { margin-top: 24px; font-size: clamp(1.3rem, 2vw, 1.8rem); line-height: 1.5; max-width: 30ch; color: var(--yellow); }
  .freedom-reading p + p { margin-top: 24px; }
  .freedom-question { font-size: 1.15rem; font-weight: 650; line-height: 1.6; padding-top: 8px; }
  .freedom-footnote { max-width: 72ch; margin-top: 32px !important; font-size: 1rem; }
  .no-script-note { margin-top: 16px !important; font-size: 14px; }
  .manifesto { display: grid; grid-template-columns: .8fr 1.2fr; gap: 8%; padding-block: 110px; }
  .manifesto-opening h2 { font-size: clamp(3.6rem, 5.8vw, 5.8rem); }
  .manifesto-opening p { margin-block: 32px; max-width: 36ch; font-size: 1.125rem; line-height: 1.75; }
  .manifesto-opening a { font-size: 1rem; }
  .reading-hint { font-size: 13px; padding-bottom: 16px; }
  .principle { border-top: 1px solid var(--green); }
  .principle:last-child { border-bottom: 1px solid var(--green); }
  .principle summary { list-style: none; display: grid; grid-template-columns: 28px minmax(0, 1fr) 22px; align-items: start; gap: 16px; padding-block: 28px; }
  .principle summary::-webkit-details-marker { display: none; }
  .principle-number { font-family: var(--font-mono); font-size: 11px; padding-top: 6px; }
  .principle summary h3 { font-size: clamp(1.6rem, 2.5vw, 2.15rem); font-stretch: 85%; font-weight: 700; line-height: 1.25; }
  .principle summary:hover h3 { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 5px; }
  .disclosure-sign { width: 18px; height: 18px; position: relative; margin-top: 5px; }
  .disclosure-sign::before, .disclosure-sign::after { content: ''; position: absolute; background: currentColor; top: 8px; left: 1px; width: 16px; height: 2px; }
  .disclosure-sign::after { transform: rotate(90deg); }
  .principle[open] .disclosure-sign::after { display: none; }
  .principle-reading { padding: 0 38px 32px 44px; font-size: 1.0625rem; line-height: 1.75; }
  .principle-lead { font-size: 1.125rem; line-height: 1.6; font-weight: 650; margin-bottom: 20px !important; }
  .participation { background: var(--yellow); padding-block: 85px 70px; color: var(--dark); }
  .participation ::selection { background: var(--dark); color: var(--cream); }
  .participation-opening { display: grid; grid-template-columns: 1fr .8fr; gap: 8%; align-items: end; margin-bottom: 56px; }
  .participation-opening h2 { font-size: clamp(3.7rem, 7vw, 6rem); }
  .participation-opening p + p { margin-top: 24px; }
  .contributions { border-top: 1px solid var(--dark); }
  .contributions > div { display: grid; grid-template-columns: 1fr 1.4fr; gap: 8%; border-bottom: 1px solid color-mix(in srgb, var(--dark) 45%, transparent); padding-block: 32px; align-items: baseline; }
  .contributions dt { font-size: clamp(1.6rem, 2.7vw, 2.4rem); font-stretch: 85%; font-weight: 700; line-height: 1.3; }
  .contributions dd { max-width: 62ch; }
  .participation-note { display: grid; grid-template-columns: 1fr 1.4fr; gap: 8%; margin-top: 40px; font-size: 1rem; }
  .participation-note strong { font-size: 18px; line-height: 1.5; }
  .closing { display: grid; grid-template-columns: 1fr .8fr; align-items: end; position: relative; gap: 8%; padding-block: 138px 100px; }
  .closing > img { position: absolute; width: clamp(130px, 14vw, 200px); top: 45px; right: 0; }
  .closing h2 { font-size: clamp(4.2rem, 8.2vw, 6rem); }
  .closing h2 span { text-decoration: underline; text-decoration-color: var(--yellow); text-decoration-thickness: .12em; text-underline-offset: .02em; }
  .closing-reading { max-width: 40ch; }
  .closing-reading p + p { margin-top: 20px; }
  .closing-reading .button { margin-top: 28px; }
  @media (max-width: 1000px) {
    .page-wrap { width: calc(100% - 48px); }
    .opening h1 { font-size: clamp(3rem, 9vw, 6rem); }
    .proposal-reading { grid-template-columns: 1fr; gap: 34px; }
    .large-reading { max-width: 42ch; }
    .two-fronts { max-width: 800px; }
    .manifesto { gap: 48px; grid-template-columns: 1fr; }
    .manifesto-opening p { max-width: 52ch; }
    .principle-reading { max-width: 72ch; }
    .participation-opening { align-items: start; gap: 5%; }
  }
  @media (max-width: 700px) {
    .page-wrap { width: calc(100% - 40px); }
    .opening { min-height: 0; padding-block: 32px 40px; }
    .opening-copy { width: 100%; }
    .opening h1 { font-size: clamp(2.75rem, 15.5vw, 6rem); }
    .opening-intro { max-width: 43ch; margin-top: 32px !important; font-size: 1.125rem; }
    .opening-actions { align-items: start; flex-direction: column; gap: 24px; margin-top: 32px; }
    .proposal { padding-block: 50px 60px; }
    .folheto h2 { font-size: clamp(3rem, 10vw, 4.7rem); }
    .proposal h2 { margin-bottom: 28px; }
    .proposal h2 span { font-size: .88em; }
    .large-reading { font-size: 23px; }
    .two-fronts { grid-template-columns: 1fr; gap: 32px; }
    .two-fronts h3 { font-size: 1.6rem; }
    .freedoms { padding-block: 54px 38px; }
    .freedoms-heading { display: block; margin-bottom: 28px; }
    .freedoms-heading p { margin-top: 24px; max-width: 43ch; }
    .freedom-options { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .freedom-options label { min-height: 65px; font-size: clamp(1.25rem, 5vw, 1.8rem); justify-content: start; gap: 9px; padding-inline: 12px; }
    .freedom-options label:nth-child(3) { border-left: 0; }
    .freedom-options label:nth-child(n + 3) { border-top: 1px solid color-mix(in srgb, var(--cream) 40%, transparent); }
    .freedom-page { display: block; padding-block: 32px; }
    .freedom-title h3 { font-size: clamp(3rem, 12vw, 5.2rem); }
    .freedom-title p { font-size: 1.5rem; margin-top: 20px; max-width: 30ch; }
    .freedom-reading { margin-top: 32px; }
    .manifesto { display: block; padding-block: 64px; }
    .manifesto-opening p { max-width: 45ch; margin-block: 28px; }
    .principles { margin-top: 40px; }
    .principle summary { padding-block: 24px; gap: 12px; }
    .principle summary h3 { font-size: 1.8rem; }
    .principle-reading { padding-left: 0; padding-right: 0; }
    .participation { padding-block: 56px 42px; }
    .participation-opening { display: block; margin-bottom: 34px; }
    .participation-opening h2 { margin-bottom: 28px; }
    .contributions > div { grid-template-columns: 1fr; gap: 16px; padding-block: 28px; }
    .contributions dt { font-size: 1.9rem; }
    .participation-note { display: block; margin-top: 30px; }
    .participation-note p { margin-top: 14px; }
    .closing { grid-template-columns: 1fr; gap: 32px; padding-block: 110px 64px; }
    .closing > img { width: 140px; top: 24px; }
    .closing h2 { font-size: clamp(3.8rem, 15vw, 6rem); }
    .closing-reading { max-width: 47ch; }
  }
  @media (max-width: 380px) {
    .opening-actions .button, .closing-reading .button { width: 100%; }
    .freedom-options label { padding-inline: 8px; gap: 7px; }
    .freedom-options input { width: 15px; height: 15px; }
    .principle summary h3 { font-size: 1.6rem; }
  }
  @media print {
    .freedom-controls, .freedom-status { display: none; }
    .folheto .freedom-page[hidden] { display: grid !important; }
    .freedoms, .participation { background: transparent; color: black; }
    .freedom-title p, .freedom-status { color: black; }
    .opening-copy { width: 100%; }
  }
</style>
