---
import { getMessages, type Locale } from '../../i18n';
import capybara from '../../../assets/64e6db346ad8c01e777f7cf3f3a36383.svg';
import Scene from './Scene.astro';

interface Props { locale: Locale }
const { locale } = Astro.props;
const messages = getMessages(locale);
const signatureLines: Exclude<typeof messages.shell.signature[number], { type: 'break' }>[][] = [[]];
for (const part of messages.shell.signature) {
  if (part.type === 'break') signatureLines.push([]);
  else signatureLines[signatureLines.length - 1]!.push(part);
}
const motivations = messages.home.motivations.options;
const contributions = messages.home.participation.contributions;
---

<main id="conteudo" class="folheto" data-folheto>
  <section class="opening page-wrap" aria-labelledby="folheto-title">
    <div class="opening-copy">
      <h1 id="folheto-title">{signatureLines.map((line) => <span class={line.some((part) => part.type === 'accent' || part.type === 'mark') ? 'together' : undefined}>{line.map((part) => part.type === 'accent' || part.type === 'mark' ? <mark>{part.text}</mark> : part.type === 'strong' ? <strong>{part.text}</strong> : part.type === 'emphasis' ? <span>{part.text}</span> : part.text)}</span>)}</h1>
      <p class="opening-intro">{messages.home.opening.intro.map((part) => part.type === 'break' ? <br /> : part.type === 'strong' ? <strong>{part.text}</strong> : part.type === 'emphasis' ? <span>{part.text}</span> : part.type === 'accent' || part.type === 'mark' ? <mark>{part.text}</mark> : part.text)}</p>
      <div class="opening-actions">
        <a class="button" href="/manifesto/">{messages.home.opening.manifestoLink} <span class="reading-arrow" aria-hidden="true"></span></a>
        <a class="text-link" href="#participacao">{messages.home.opening.participationLink}</a>
      </div>
    </div>
    <Scene />
  </section>

  <section id="proposta" class="proposal page-wrap" aria-labelledby="proposal-title">
    <h2 id="proposal-title">{messages.home.proposal.heading.map((part) => part.type === 'break' ? <br /> : part.type === 'emphasis' ? <span>{part.text}</span> : part.type === 'strong' ? <strong>{part.text}</strong> : part.type === 'mark' || part.type === 'accent' ? <mark>{part.text}</mark> : part.text)}</h2>
    <p class="large-reading">{messages.home.proposal.lead}</p>
    <div class="proposal-reading">
      {[
        { title: messages.home.proposal.aboutTitle, body: messages.home.proposal.about },
        { title: messages.home.proposal.communityTitle, body: messages.home.proposal.community },
        { title: messages.home.proposal.autonomyTitle, body: messages.home.proposal.autonomy },
      ].map(({ title, body }) => <article><h3>{title}</h3><p>{body}</p></article>)}
    </div>
  </section>

  <section class="motivations" aria-labelledby="motivations-title">
    <div class="page-wrap">
      <div class="motivations-heading"><h2 id="motivations-title">{messages.home.motivations.title.map((part) => part.type === 'break' ? <br /> : part.type === 'emphasis' ? <span>{part.text}</span> : part.type === 'strong' ? <strong>{part.text}</strong> : part.type === 'mark' || part.type === 'accent' ? <mark>{part.text}</mark> : part.text)}</h2><p>{messages.home.motivations.intro}</p></div>
      <dl class="motivation-decisions">
        {motivations.map((motivation) => (
          <div class="motivation-row">
            <dt class="motivation-question">
              <p class="motivation-topic">{motivation.title}</p>
              <h3>{motivation.question}</h3>
            </dt>
            <dd class="motivation-response">
              <p><strong>{messages.home.motivations.problemLabel}</strong>{motivation.problem}</p>
              <p><strong>{messages.home.motivations.approachLabel}</strong>{motivation.approach}</p>
            </dd>
          </div>
        ))}
      </dl>
      <p class="motivation-footnote">{messages.home.motivations.footnote}</p>
    </div>
  </section>

  <section id="manifesto" class="manifesto page-wrap" aria-labelledby="manifesto-title">
    <div class="manifesto-opening"><h2 id="manifesto-title">{messages.home.manifesto.heading.map((part) => part.type === 'break' ? <br /> : part.type === 'emphasis' ? <span>{part.text}</span> : part.type === 'strong' ? <strong>{part.text}</strong> : part.type === 'mark' || part.type === 'accent' ? <mark>{part.text}</mark> : part.text)}</h2><p>{messages.home.manifesto.description}</p><a class="text-link" href="/manifesto/">{messages.home.manifesto.link} <span class="reading-arrow" aria-hidden="true"></span></a></div>
    <div class="principles"><p class="reading-hint">{messages.home.manifesto.readingHint}</p>{messages.manifesto.principles.map((principle, index) => (
      <details class="principle" open={index === 0}>
        <summary><span class="principle-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span><h3>{principle.title}</h3><span class="disclosure-sign" aria-hidden="true"></span></summary>
        <div class="principle-reading"><p class="principle-lead">{principle.lead}</p><p>{principle.body}</p></div>
      </details>
    ))}</div>
  </section>

  <section id="participacao" class="participation" aria-labelledby="participation-title">
    <div class="page-wrap">
      <div class="participation-opening"><h2 id="participation-title">{messages.home.participation.heading.map((part) => part.type === 'break' ? <br /> : part.type === 'emphasis' ? <span>{part.text}</span> : part.type === 'strong' ? <strong>{part.text}</strong> : part.type === 'mark' || part.type === 'accent' ? <mark>{part.text}</mark> : part.text)}</h2><div><p>{messages.home.participation.intro}</p><p>{messages.home.participation.context}</p></div></div>
      <dl class="contributions">{contributions.map(([title, body]) => <div><dt>{title}</dt><dd>{body}</dd></div>)}</dl>
      <div class="participation-note"><strong>{messages.home.participation.noteLead}</strong><p>{messages.home.participation.note}</p></div>
    </div>
  </section>

  <section class="closing page-wrap" aria-labelledby="closing-title">
    <img src={capybara.src} alt="" width="352" height="192" loading="lazy" />
    <div class="closing-heading"><h2 id="closing-title">{messages.home.closing.heading.map((part) => part.type === 'break' ? <br /> : part.type === 'emphasis' ? <span>{part.text}</span> : part.type === 'strong' ? <strong>{part.text}</strong> : part.type === 'mark' || part.type === 'accent' ? <mark>{part.text}</mark> : part.text)}</h2></div>
    <div class="closing-reading"><p>{messages.home.closing.reading}</p><form class="closing-idea-form">
      <label for="folheto-idea">{messages.home.closing.form.label}</label>
      <textarea id="folheto-idea" name="idea" rows="5" placeholder={messages.home.closing.form.placeholder}></textarea>
      <p class="closing-form-note">{messages.home.closing.form.privacyNote}</p>
      <button class="button" type="button" disabled>{messages.home.closing.form.submit}</button>
    </form></div>
  </section>
</main>

<style>
  .folheto { color: var(--green); background: var(--paper); overflow: clip; overflow-wrap: break-word; font-size: 1.0625rem; line-height: 1.75; }
  .page-wrap { width: min(1320px, calc(100% - 80px)); margin-inline: auto; }
  .folheto :is(h1, h2, h3, p, dl, dd) { margin: 0; }
  .folheto :is(h1, h2) { font-family: var(--font-display); font-stretch: 72%; font-weight: 800; text-transform: uppercase; letter-spacing: -.015em; line-height: 1.05; }
  .folheto h2 { font-size: clamp(3.2rem, 6.3vw, 6rem); }
  .folheto h2 span { color: inherit; }
  .folheto a { text-underline-offset: .25em; }
  .reading-arrow { display: inline-block; position: relative; width: 16px; height: 13px; margin-left: 4px; vertical-align: middle; flex: 0 0 auto; }
  .reading-arrow::before { content: ''; position: absolute; width: 15px; height: 1px; background: currentColor; left: 0; top: 6px; }
  .reading-arrow::after { content: ''; position: absolute; width: 8px; height: 8px; border-top: 1px solid currentColor; border-right: 1px solid currentColor; transform: rotate(45deg); right: 1px; top: 2px; }
  .folheto :is(a, summary, input, textarea, button):focus-visible { outline: 3px solid var(--blue); outline-offset: 6px; }
  .folheto [hidden] { display: none !important; }
  .opening { position: relative; min-height: clamp(650px, 56vw, 800px); padding-block: clamp(36px, 4vw, 64px) 68px; }
  .opening-copy { position: relative; z-index: 1; width: 56%; }
  .opening h1 { font-size: clamp(5rem, 8.2vw, 6rem); line-height: 1.02; }
  .opening h1 > span { display: block; }
  .together { margin-block: .04em .17em; }
  .opening mark { position: relative; isolation: isolate; color: var(--green); background: none; padding-inline: .035em .12em; margin-left: -.035em; }
  .opening mark::before { content: ''; position: absolute; z-index: -1; inset: 13% 0 -5%; background: var(--yellow); transform: rotate(-2deg); transform-origin: left center; }
  .opening-intro { font-size: clamp(1.125rem, 1.6vw, 1.4rem); line-height: 1.65; max-width: 42ch; margin-top: 32px !important; }
  .opening-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 24px 32px; margin-top: 32px; }
  .opening-actions .text-link { font-size: 1rem; }
  .proposal { padding-block: 76px 100px; border-top: 2px solid var(--green); }
  .proposal h2 { max-width: 1000px; margin-bottom: 46px; }
  .proposal h2 span { font-size: .78em; }
  .large-reading { font-size: clamp(1.3rem, 2.2vw, 1.9rem); line-height: 1.5; max-width: 27ch; margin-bottom: 40px !important; }
  .proposal-reading { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 32px; }
  .proposal-reading h3 { font-size: 1.7rem; font-stretch: 85%; line-height: 1.25; margin-bottom: 16px; }
  .proposal-reading p { line-height: 1.75; }
  .motivations { background: var(--green); color: var(--cream); padding-block: 96px 68px; }
  .motivations-heading { display: flex; align-items: end; gap: 40px; justify-content: space-between; margin-bottom: 52px; }
  .motivations-heading p { max-width: 40ch; font-size: 1.0625rem; line-height: 1.75; }
  .motivation-decisions { margin: 0; border-top: 1px solid color-mix(in srgb, var(--cream) 45%, transparent); }
  .motivation-row { display: grid; grid-template-columns: minmax(0, .85fr) minmax(0, 1.15fr); gap: 8%; padding-block: 36px; border-bottom: 1px solid color-mix(in srgb, var(--cream) 35%, transparent); }
  .motivation-question { margin: 0; }
  .motivation-topic { margin-bottom: 12px !important; color: var(--yellow); font-size: .875rem; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; }
  .motivation-question h3 { font-size: clamp(1.8rem, 3.2vw, 2.8rem); font-stretch: 78%; font-weight: 800; letter-spacing: -.015em; line-height: 1.15; }
  .motivation-response { margin: 0; }
  .motivation-response p { max-width: 66ch; }
  .motivation-response p + p { margin-top: 24px; }
  .motivation-response strong { display: block; margin-bottom: 6px; color: var(--yellow); }
  .motivation-footnote { max-width: 72ch; margin-top: 32px !important; font-size: 1rem; }
  .manifesto { display: grid; grid-template-columns: .8fr 1.2fr; gap: 8%; padding-block: 110px; }
  .manifesto-opening h2 { font-size: clamp(3.6rem, 5.8vw, 5.8rem); }
  .manifesto-opening p { margin-block: 32px; max-width: 36ch; font-size: 1.125rem; line-height: 1.75; }
  .manifesto-opening a { font-size: 1rem; }
  .reading-hint { font-size: 13px; padding-bottom: 16px; }
  .principle { border-top: 1px solid var(--green); }
  .principle:last-child { border-bottom: 1px solid var(--green); }
  .principle summary { list-style: none; display: grid; grid-template-columns: 28px minmax(0, 1fr) 22px; align-items: start; gap: 16px; padding-block: 28px; }
  .principle summary::-webkit-details-marker { display: none; }
  .principle-number { font-family: var(--font-mono); font-size: 11px; padding-top: 6px; }
  .principle summary h3 { font-size: clamp(1.6rem, 2.5vw, 2.15rem); font-stretch: 85%; font-weight: 700; line-height: 1.25; }
  .principle summary:hover h3 { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 5px; }
  .disclosure-sign { width: 18px; height: 18px; position: relative; margin-top: 5px; }
  .disclosure-sign::before, .disclosure-sign::after { content: ''; position: absolute; background: currentColor; top: 8px; left: 1px; width: 16px; height: 2px; }
  .disclosure-sign::after { transform: rotate(90deg); }
  .principle[open] .disclosure-sign::after { display: none; }
  .principle-reading { padding: 0 38px 32px 44px; font-size: 1.0625rem; line-height: 1.75; }
  .principle-lead { font-size: 1.125rem; line-height: 1.6; font-weight: 650; margin-bottom: 20px !important; }
  .participation { background: var(--yellow); padding-block: 85px 70px; color: var(--dark); }
  .participation ::selection { background: var(--dark); color: var(--cream); }
  .participation-opening { display: grid; grid-template-columns: 1fr .8fr; gap: 8%; align-items: end; margin-bottom: 56px; }
  .participation-opening h2 { font-size: clamp(3.7rem, 7vw, 6rem); }
  .participation-opening p + p { margin-top: 24px; }
  .contributions { border-top: 1px solid var(--dark); }
  .contributions > div { display: grid; grid-template-columns: 1fr 1.4fr; gap: 8%; border-bottom: 1px solid color-mix(in srgb, var(--dark) 45%, transparent); padding-block: 32px; align-items: baseline; }
  .contributions dt { font-size: clamp(1.6rem, 2.7vw, 2.4rem); font-stretch: 85%; font-weight: 700; line-height: 1.3; }
  .contributions dd { max-width: 62ch; }
  .participation-note { display: grid; grid-template-columns: 1fr 1.4fr; gap: 8%; margin-top: 40px; font-size: 1rem; }
  .participation-note strong { font-size: 18px; line-height: 1.5; }
  .closing { display: grid; grid-template-columns: 1fr .8fr; align-items: start; position: relative; gap: 8%; padding-block: 138px 100px; }
  .closing > img { position: absolute; width: clamp(130px, 14vw, 200px); top: 45px; right: 0; }
  .closing h2 { font-size: clamp(4.2rem, 8.2vw, 6rem); }
  .closing h2 span { text-decoration: underline; text-decoration-color: var(--yellow); text-decoration-thickness: .12em; text-underline-offset: .02em; }
  .closing-reading { max-width: 40ch; }
  .closing-idea-form { display: grid; justify-items: start; gap: 11px; margin-top: 28px; }
  .closing-idea-form label { font-weight: 700; }
  .closing-idea-form textarea { box-sizing: border-box; width: 100%; min-height: 144px; padding: 12px; color: var(--green); background: var(--cream); border: 1px solid var(--green); border-radius: 0; font: inherit; line-height: 1.55; resize: vertical; }
  .closing-idea-form textarea::placeholder { color: var(--green); opacity: 1; }
  .closing-idea-form textarea:focus-visible { outline: 3px solid var(--blue); outline-offset: 4px; }
  .closing-idea-form .closing-form-note { color: var(--green); font-size: 12px; line-height: 1.6; }
  .closing-idea-form .button:disabled { background: color-mix(in srgb, var(--green) 45%, var(--paper)); color: var(--green); cursor: not-allowed; }
  @media (max-width: 1000px) {
    .page-wrap { width: calc(100% - 48px); }
    .opening h1 { font-size: clamp(3rem, 9vw, 6rem); }
    .proposal-reading { grid-template-columns: 1fr; gap: 34px; }
    .large-reading { max-width: 64ch; }
    .manifesto { gap: 48px; grid-template-columns: 1fr; }
    .manifesto-opening p { max-width: 52ch; }
    .principle-reading { max-width: 72ch; }
    .participation-opening { align-items: start; gap: 5%; }
  }
  @media (max-width: 700px) {
    .page-wrap { width: calc(100% - 40px); }
    .opening { min-height: 0; padding-block: 32px 40px; }
    .opening-copy { width: 100%; }
    .opening h1 { font-size: clamp(2.75rem, 15.5vw, 6rem); }
    .opening-intro { max-width: 43ch; margin-top: 32px !important; font-size: 1.125rem; }
    .opening-actions { align-items: start; flex-direction: column; gap: 24px; margin-top: 32px; }
    .proposal { padding-block: 50px 60px; }
    .folheto h2 { font-size: clamp(3rem, 10vw, 4.7rem); }
    .proposal h2 { margin-bottom: 28px; }
    .proposal h2 span { font-size: .88em; }
    .large-reading { font-size: 23px; }
    .proposal-reading { grid-template-columns: 1fr; gap: 32px; }
    .motivations { padding-block: 58px 42px; }
    .motivations-heading { display: block; margin-bottom: 34px; }
    .motivations-heading p { margin-top: 24px; max-width: 43ch; }
    .motivation-row { grid-template-columns: minmax(0, 1fr); gap: 18px; padding-block: 30px; }
    .motivation-question h3 { max-width: 24ch; font-size: clamp(1.8rem, 7vw, 2.6rem); }
    .motivation-response p + p { margin-top: 20px; }
    .manifesto { display: block; padding-block: 64px; }
    .manifesto-opening p { max-width: 45ch; margin-block: 28px; }
    .principles { margin-top: 40px; }
    .principle summary { padding-block: 24px; gap: 12px; }
    .principle summary h3 { font-size: 1.8rem; }
    .principle-reading { padding-left: 0; padding-right: 0; }
    .participation { padding-block: 56px 42px; }
    .participation-opening { display: block; margin-bottom: 34px; }
    .participation-opening h2 { margin-bottom: 28px; }
    .contributions > div { grid-template-columns: 1fr; gap: 16px; padding-block: 28px; }
    .contributions dt { font-size: 1.9rem; }
    .participation-note { display: block; margin-top: 30px; }
    .participation-note p { margin-top: 14px; }
    .closing { grid-template-columns: 1fr; gap: 32px; padding-block: 110px 64px; }
    .closing > img { width: 140px; top: 24px; }
    .closing h2 { font-size: clamp(3.8rem, 15vw, 6rem); }
    .closing-reading { max-width: 47ch; }
    .closing-idea-form textarea { min-height: 132px; }
  }
  @media (max-width: 380px) {
    .opening-actions .button, .closing-idea-form .button { width: 100%; }
    .principle summary h3 { font-size: 1.6rem; }
  }
  @media print {
    .motivations, .participation { background: transparent; color: black; }
    .motivation-response strong, .motivation-topic { color: black; }
    .opening-copy { width: 100%; }
  }
</style>
