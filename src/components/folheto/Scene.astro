---
import emblem from '../../../assets/b084774a04a4acde15a270ee03518180.svg';
import toucan from '../../../assets/18b51d99adf971345c6d3e2da4ff6e2c.svg';
import capybara from '../../../assets/64e6db346ad8c01e777f7cf3f3a36383.svg';
import ipe from '../../../assets/77b83da13ccc31cb0f862276cf552fac.svg';

---

<div class="print-scene" data-print-scene aria-hidden="true">
  <div class="scene-emblem"><img src={emblem.src} alt="" width="462" height="654" fetchpriority="high" /></div>
  <svg class="scene-wind" viewBox="0 0 240 100" fill="none" aria-hidden="true">
    <path data-print-wind="0" d="M24 18 C72 4 112 30 172 16" />
    <path data-print-wind="1" d="M12 48 C78 30 128 66 222 44" />
    <path data-print-wind="2" d="M48 78 C92 64 124 88 176 74" />
  </svg>
  <img class="scene-toucan" data-print-toucan src={toucan.src} alt="" width="472" height="208" fetchpriority="high" />
  <img class="scene-ipe" data-print-ipe src={ipe.src} alt="" width="196" height="212" />
  <div class="scene-capybara" data-print-capybara>
    <img data-print-capybara-gait src={capybara.src} alt="" width="352" height="192" />
  </div>
</div>

<script>
  import './scene';
</script>

<style>
  .print-scene { position: absolute; isolation: isolate; width: 40%; aspect-ratio: 4 / 5; top: 48px; right: 0; pointer-events: none; }
  .scene-emblem { position: absolute; z-index: -1; top: 0; right: -3%; width: 86%; opacity: .22; }
  .scene-emblem img { display: block; width: 100%; height: auto; }
  .scene-toucan { position: absolute; z-index: 2; width: 76%; top: 0; left: 0; transform-origin: 58% 50%; }
  .scene-wind { position: absolute; z-index: 1; width: 48%; top: 29%; left: 0; overflow: visible; stroke: var(--green); stroke-width: 2; stroke-linecap: round; }
  .scene-wind path { opacity: 0; vector-effect: non-scaling-stroke; }
  .scene-capybara { position: absolute; z-index: 2; bottom: 2%; width: 52%; left: 0; }
  .scene-capybara img { display: block; width: 100%; height: auto; transform-origin: 50% 85%; }
  .scene-ipe { position: absolute; z-index: 2; width: 24%; bottom: 2%; right: 0; transform-origin: 50% 100%; }
  @media (max-width: 700px) {
    .print-scene { position: relative; inset: auto; width: min(100%, 430px); margin: 48px auto 64px; }
  }
  @media print {
    .print-scene { display: none; }
  }
</style>
