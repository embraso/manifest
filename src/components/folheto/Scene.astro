---
import toucan from '../../../assets/18b51d99adf971345c6d3e2da4ff6e2c.svg';
import capybara from '../../../assets/64e6db346ad8c01e777f7cf3f3a36383.svg';
import ipe from '../../../assets/77b83da13ccc31cb0f862276cf552fac.svg';
import BrazilFlag from '../brand/BrazilFlag.astro';
import ParkLandscape from './ParkLandscape.astro';

---

<div class="print-scene" data-print-scene aria-hidden="true">
  <div class="scene-landscape"><ParkLandscape /></div>
  <svg class="scene-wind" viewBox="0 0 240 100" fill="none" aria-hidden="true">
    <path data-print-wind="0" d="M24 18 C72 4 112 30 172 16" />
    <path data-print-wind="1" d="M12 48 C78 30 128 66 222 44" />
    <path data-print-wind="2" d="M48 78 C92 64 124 88 176 74" />
  </svg>
  <img class="scene-toucan" data-print-toucan src={toucan.src} alt="" width="472" height="208" fetchpriority="high" />
  <img class="scene-ipe" data-print-ipe src={ipe.src} alt="" width="196" height="212" />
  <div class="scene-flag"><span class="flag-pole"></span><BrazilFlag /></div>
  <div class="scene-capybara" data-print-capybara>
    <img data-print-capybara-gait src={capybara.src} alt="" width="352" height="192" />
  </div>
</div>

<script>
  import './scene';
</script>

<style>
  .print-scene { position: relative; isolation: isolate; height: clamp(290px, 28vw, 400px); width: 100%; pointer-events: none; }
  .scene-landscape { position: absolute; inset: 0; }
  .scene-toucan { position: absolute; z-index: 2; width: clamp(120px, 15vw, 215px); top: 8%; left: 20%; transform-origin: 58% 50%; }
  .scene-wind { position: absolute; z-index: 1; width: 14%; top: 14%; left: 36%; overflow: visible; stroke: var(--green); stroke-width: 2; stroke-linecap: round; }
  .scene-wind path { opacity: 0; vector-effect: non-scaling-stroke; }
  .scene-capybara { position: absolute; z-index: 3; bottom: 10%; width: clamp(150px, 17vw, 245px); left: 37%; }
  .scene-capybara img { display: block; width: 100%; height: auto; transform-origin: 50% 85%; }
  .scene-ipe { position: absolute; z-index: 2; width: clamp(95px, 12vw, 172px); bottom: 19%; left: 12%; transform-origin: 50% 100%; }
  .scene-flag { position: absolute; z-index: 2; width: clamp(95px, 10vw, 145px); bottom: 36%; left: 73%; transform: rotate(-3deg); }
  .flag-pole { position: absolute; left: -5px; top: -6px; width: 5px; height: 185%; background: #7e4f2a; border-radius: 3px; }
  .flag-pole::before { content: ''; position: absolute; width: 11px; height: 11px; top: -5px; left: -3px; background: var(--yellow); border-radius: 50%; }
  @media (max-width: 700px) {
    .print-scene { height: 290px; margin-top: 18px; }
    .scene-toucan { left: 6%; top: 4%; width: 118px; }
    .scene-wind { top: 16%; left: 38%; width: 24%; }
    .scene-capybara { left: 31%; bottom: 10%; width: 156px; }
    .scene-ipe { width: 84px; left: 4%; bottom: 23%; }
    .scene-flag { left: 70%; bottom: 40%; width: 87px; }
  }
  @media print {
    .print-scene { display: none; }
  }
</style>
