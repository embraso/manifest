---
import { principles } from '../data/manifesto';
import emblem from '../../assets/b084774a04a4acde15a270ee03518180.svg';
import toucan from '../../assets/18b51d99adf971345c6d3e2da4ff6e2c.svg';
import capybara from '../../assets/64e6db346ad8c01e777f7cf3f3a36383.svg';
import ipe from '../../assets/77b83da13ccc31cb0f862276cf552fac.svg';

const motivations = [
  {
    id: 'vida-em-comum',
    title: 'Vida em comum',
    lead: 'Ferramentas que ajudem a viver, não só a consumir.',
    problem: 'Uma sala de aula, um coletivo cultural ou um pequeno negócio tem necessidades que nem sempre cabem nas ferramentas disponíveis. Produzir mais um aplicativo, sem ouvir essas pessoas, não resolve isso.',
    goal: 'Queremos aproximar quem conhece o problema de quem pode compartilhar conhecimento e construir junto. Aprender, criar e se organizar nas diferentes realidades do Brasil é o que dá sentido ao software.',
  },
  {
    id: 'autonomia',
    title: 'Autonomia',
    lead: 'Mudar de ferramenta sem perder o que foi construído.',
    problem: 'Um bloqueio, uma mudança de regra ou o fim de um serviço pode interromper um projeto. Quando os dados e o conhecimento ficam presos ali, continuar vira uma decisão de outra pessoa.',
    goal: 'Queremos caminhos para recuperar dados, adaptar ferramentas e mudar de serviço. Colaborar e usar recursos externos pode fazer parte da escolha, sem abrir mão de compreender as dependências e planejar a continuidade.',
  },
  {
    id: 'conhecimento',
    title: 'Conhecimento',
    lead: 'Mais gente capaz de compreender, adaptar e compartilhar.',
    problem: 'Quando só podemos usar uma ferramenta, sem entender ou alterar seu funcionamento, criar uma solução fica restrito a quem controla o programa. Conhecimento concentrado limita os caminhos de quem vem depois.',
    goal: 'Defendemos software livre e conhecimento compartilhado para que mais pessoas possam usar, estudar, modificar e redistribuir o que construímos, inclusive em atividades comerciais. Acesso ao código precisa vir acompanhado dessas permissões.',
  },
  {
    id: 'atencao',
    title: 'Atenção',
    lead: 'Mais troca e descoberta. Menos tempo preso à tela.',
    problem: 'Consumir conteúdo sem parar não é o mesmo que conversar. Quando não entendemos por que algo aparece nem podemos mudar as recomendações, fica mais difícil escolher o que acompanhar.',
    goal: 'Queremos ferramentas que favoreçam encontros, pensamento crítico e descoberta. Defendemos escolher fontes e pessoas, entender os critérios, ajustar ou desligar recomendações e questionar decisões automatizadas.',
  },
  {
    id: 'privacidade',
    title: 'Privacidade',
    lead: 'Participar da vida digital sem abrir mão do cuidado.',
    problem: 'Coletar dados além do necessário e usá-los sem clareza expõe pessoas a vigilância, fraudes e perda de privacidade. Esse risco não desaparece só porque o código está aberto.',
    goal: 'Queremos cuidar dos dados desde o início: coletar apenas o necessário, explicar o uso e proteger de acordo com os riscos. Manutenção, correções e limites claros fazem parte desse compromisso.',
  },
  {
    id: 'continuidade',
    title: 'Continuidade',
    lead: 'Boas ideias precisam de condições para durar.',
    problem: 'Custos que não cabem no orçamento, complexidade excessiva e conhecimento nas mãos de uma só pessoa podem inviabilizar uma ferramenta útil. Exigir a tecnologia ideal antes de começar também pode impedir o primeiro passo.',
    goal: 'Queremos começar com os recursos disponíveis e fazer escolhas que possam ser compreendidas e mantidas. Software livre não significa trabalho gratuito: documentação, cuidado e remuneração justa precisam entrar na conta.',
  },
];
const contributions = [
  ['Conhecer o problema', 'Contar como uma dificuldade aparece no cotidiano e o que já foi tentado. Escutar quem vive a situação vem antes de propor uma ferramenta.'],
  ['Explicar e aproximar', 'Escrever, traduzir, ensinar, pesquisar ou conectar iniciativas. Uma explicação compreensível também abre caminhos.'],
  ['Desenhar e experimentar', 'Observar o uso, apontar barreiras de acessibilidade e experimentar ideias em aparelhos e conexões diferentes.'],
  ['Programar e cuidar', 'Construir, documentar, corrigir e manter. Cuidar da continuidade é trabalho e merece reconhecimento e condições justas.'],
];
---

<main id="conteudo" class="folheto" data-folheto>
  <section class="opening page-wrap" aria-labelledby="folheto-title" data-print-scene>
    <div class="opening-copy">
      <h1 id="folheto-title"><span>Liberdade</span><span>se constrói</span><span class="together"><mark>junto.</mark></span></h1>
      <p class="opening-intro">A Embraso é uma iniciativa para reunir pessoas e criar <strong>software útil e livre</strong>, pensado para as diferentes realidades do Brasil.</p>
      <div class="opening-actions">
        <a class="button" href="/manifesto/">Ler o manifesto <span class="reading-arrow" aria-hidden="true"></span></a>
        <a class="text-link" href="#participacao">Como participar dessa construção</a>
      </div>
    </div>
    <div class="print-scene" aria-hidden="true">
      <svg class="scene-wind" viewBox="0 0 472 208" fill="none" aria-hidden="true">
        <path data-print-wind="0" d="M16 64 C58 48 92 74 142 56" />
        <path data-print-wind="1" d="M4 112 C58 92 110 126 178 104" />
        <path data-print-wind="2" d="M48 156 C84 142 116 164 150 150" />
      </svg>
      <img class="scene-toucan" data-print-toucan src={toucan.src} alt="" width="472" height="208" fetchpriority="high" />
      <div class="scene-emblem"><img src={emblem.src} alt="" width="462" height="654" fetchpriority="high" /></div>
      <img class="scene-ipe" data-print-ipe src={ipe.src} alt="" width="196" height="212" />
      <img class="scene-capybara" data-print-capybara src={capybara.src} alt="" width="352" height="192" />
      <span class="scene-caption">Conhecimento que circula.<br />Liberdade que continua.</span>
    </div>
  </section>

  <section id="proposta" class="proposal page-wrap" aria-labelledby="proposal-title">
    <h2 id="proposal-title">Mais do que código.<br /><span>Gente com quem construir.</span></h2>
    <div class="proposal-reading">
      <div><p class="large-reading">Queremos dedicar o que sabemos a algo que faça diferença na vida das pessoas. Não apenas consumir conteúdo, mas trocar, descobrir e fazer coisas juntos.</p><p class="proposal-opportunity">Ferramentas de desenvolvimento podem aproximar uma ideia de algo que funciona. Há gente no Brasil e fora dele com conhecimento para compartilhar. Queremos conectar essa possibilidade a quem conhece os problemas.</p></div>
      <div class="two-fronts">
        <article><h3>Comunidade.</h3><p>Aproximar quem conhece um problema de quem pode compartilhar um conhecimento. Escutar, aprender e construir com as pessoas envolvidas.</p></article>
        <article><h3>Autonomia.</h3><p>Compreender as ferramentas, poder adaptá-las e levar seus dados para outro lugar. Ter escolhas sem precisar fazer tudo por conta própria.</p></article>
      </div>
    </div>
  </section>

  <section class="motivations" aria-labelledby="motivations-title" data-motivation-reader>
    <div class="page-wrap">
      <div class="motivations-heading"><h2 id="motivations-title">Por que a<br />Embraso existe?</h2><p>Há dificuldades que queremos enfrentar juntos. Conheça o que nos move e o que queremos mudar.</p></div>
      <fieldset class="motivation-controls" data-motivation-controls hidden>
        <legend>Escolha um tema para ler</legend>
        <div class="motivation-options">
          {motivations.map((motivation, index) => <label for={`motivation-choice-${motivation.id}`}><input id={`motivation-choice-${motivation.id}`} type="radio" name="motivation" value={motivation.id} checked={index === 0} aria-controls={`motivation-reading-${motivation.id}`} /><span>{motivation.title}</span></label>)}
        </div>
      </fieldset>
      <p class="motivation-status" role="status" aria-live="polite" aria-atomic="true" data-motivation-status hidden></p>
      <div class="motivation-pages">
        {motivations.map((motivation) => (
          <article class="motivation-page" id={`motivation-reading-${motivation.id}`} data-motivation-page={motivation.id} aria-labelledby={`motivation-heading-${motivation.id}`}>
            <div class="motivation-title"><h3 id={`motivation-heading-${motivation.id}`}>{motivation.title}</h3><p>{motivation.lead}</p></div>
            <div class="motivation-reading"><p><strong>O que queremos enfrentar</strong>{motivation.problem}</p><p><strong>O que queremos construir</strong>{motivation.goal}</p></div>
          </article>
        ))}
      </div>
      <p class="motivation-footnote">Essas são as mudanças que buscamos, não uma lista de ferramentas já disponíveis. Os seis princípios do manifesto orientam como queremos construir esse caminho.</p>
      <noscript><p class="no-script-note">As seis leituras estão abertas acima. Você pode ler todas, sem ativar JavaScript.</p></noscript>
    </div>
  </section>

  <section id="manifesto" class="manifesto page-wrap" aria-labelledby="manifesto-title">
    <div class="manifesto-opening"><h2 id="manifesto-title">Uma direção.<br />Seis princípios.</h2><p>O que abrir. O que proteger. De quem depender. Quem ouvir. O manifesto orienta as escolhas difíceis — não é a obra pronta.</p><a class="text-link" href="/manifesto/">Ler o manifesto completo <span class="reading-arrow" aria-hidden="true"></span></a></div>
    <div class="principles"><p class="reading-hint">Abra os princípios para ler.</p>{principles.map((principle, index) => (
      <details class="principle" open={index === 0}>
        <summary><span class="principle-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span><h3>{principle.title}</h3><span class="disclosure-sign" aria-hidden="true"></span></summary>
        <div class="principle-reading"><p class="principle-lead">{principle.lead}</p><p>{principle.body}</p></div>
      </details>
    ))}</div>
  </section>

  <section id="participacao" class="participation" aria-labelledby="participation-title">
    <div class="page-wrap">
      <div class="participation-opening"><h2 id="participation-title">Não precisa saber<br /><span>programar.</span></h2><div><p>Quem conhece uma necessidade de perto tem algo que o código, sozinho, não sabe. Queremos reunir experiências diferentes — inclusive de quem ainda está aprendendo.</p><p>Estar no Brasil não é um requisito para se interessar. Importa ouvir quem vive cada contexto e respeitar seu tempo, seus recursos e seus caminhos.</p></div></div>
      <dl class="contributions">{contributions.map(([title, body]) => <div><dt>{title}</dt><dd>{body}</dd></div>)}</dl>
      <div class="participation-note"><strong>Interesse não é obrigação.</strong><p>Você não precisa saber tudo nem ter tempo toda semana. Colaboração não pressupõe trabalho gratuito ou disponibilidade permanente. As formas concretas de participação ainda estão sendo construídas; por enquanto, conhecer o manifesto é o caminho disponível.</p></div>
    </div>
  </section>

  <section class="closing page-wrap" aria-labelledby="closing-title">
    <img src={capybara.src} alt="" width="352" height="192" loading="lazy" />
    <div class="closing-heading"><h2 id="closing-title">Que problema<br />você conhece<br /><span>por dentro?</span></h2></div>
    <div class="closing-reading"><p>Uma boa pergunta já é um começo. Antes de propor mais um aplicativo, queremos entender o que já funciona, o que falta e o que vale construir junto.</p><p>Conheça os princípios que orientam essa iniciativa.</p><a class="button" href="/manifesto/">Comece pelo manifesto <span class="reading-arrow" aria-hidden="true"></span></a></div>
  </section>
</main>

<script>
  import '../scripts/folheto';
</script>

<style>
  .folheto { color: var(--green); background: var(--paper); overflow: clip; overflow-wrap: break-word; }
  .page-wrap { width: min(1320px, calc(100% - 80px)); margin-inline: auto; }
  .folheto :is(h1, h2, h3, p, dl, dd) { margin: 0; }
  .folheto :is(h1, h2) { font-family: var(--font-display); font-stretch: 62%; font-weight: 850; text-transform: uppercase; letter-spacing: -.035em; line-height: .92; }
  .folheto h2 { font-size: clamp(3.2rem, 6.3vw, 6rem); }
  .folheto h2 span { color: inherit; }
  .folheto a { text-underline-offset: .25em; }
  .reading-arrow { display: inline-block; position: relative; width: 16px; height: 13px; margin-left: 4px; vertical-align: middle; flex: 0 0 auto; }
  .reading-arrow::before { content: ''; position: absolute; width: 15px; height: 1px; background: currentColor; left: 0; top: 6px; }
  .reading-arrow::after { content: ''; position: absolute; width: 8px; height: 8px; border-top: 1px solid currentColor; border-right: 1px solid currentColor; transform: rotate(45deg); right: 1px; top: 2px; }
  .folheto :is(a, summary, input):focus-visible { outline: 3px solid var(--blue); outline-offset: 6px; }
  .folheto [hidden] { display: none !important; }
  .opening { position: relative; min-height: 650px; padding-block: clamp(36px, 4vw, 64px) 68px; }
  .opening-copy { position: relative; z-index: 1; width: 62%; }
  .opening h1 { font-size: clamp(5rem, 8.2vw, 6rem); line-height: .88; }
  .opening h1 > span { display: block; }
  .together { margin-block: .04em .17em; }
  .opening mark { position: relative; isolation: isolate; color: var(--green); background: none; padding-inline: .035em .12em; margin-left: -.035em; }
  .opening mark::before { content: ''; position: absolute; z-index: -1; inset: 13% 0 -5%; background: var(--yellow); transform: rotate(-2deg); transform-origin: left center; }
  .opening-intro { font-size: clamp(1.125rem, 1.6vw, 1.4rem); line-height: 1.5; max-width: 39ch; margin-top: 28px !important; }
  .opening-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 18px 26px; margin-top: 26px; }
  .opening-actions .text-link { font-size: 14px; }
  .print-scene { position: absolute; width: 35%; top: 9%; bottom: 65px; right: 0; }
  .scene-toucan { position: absolute; z-index: 3; width: 94%; top: -3%; left: -12%; transform-origin: 58% 50%; }
  .scene-wind { position: absolute; z-index: 2; width: 94%; top: -3%; left: -12%; overflow: visible; pointer-events: none; stroke: var(--green); stroke-width: 1.5; stroke-linecap: round; }
  .scene-wind path { opacity: 0; }
  .scene-emblem { position: absolute; top: 11%; right: 4%; width: 67%; }
  .scene-emblem img { width: 100%; }
  .scene-capybara { position: absolute; z-index: 2; bottom: 40px; width: 68%; left: -10%; transform-origin: 50% 85%; }
  .scene-ipe { position: absolute; width: 36%; bottom: 45px; right: -2%; transform-origin: 50% 100%; }
  .scene-caption { position: absolute; bottom: -7px; right: 0; text-align: right; font-size: 12px; line-height: 1.45; }
  .proposal { padding-block: 76px 100px; border-top: 2px solid var(--green); }
  .proposal h2 { max-width: 1000px; margin-bottom: 46px; }
  .proposal h2 span { font-size: .78em; }
  .proposal-reading { display: grid; grid-template-columns: 1fr 1.2fr; gap: 8%; }
  .large-reading { font-size: clamp(1.3rem, 2.2vw, 1.9rem); line-height: 1.4; max-width: 27ch; }
  .proposal-opportunity { margin-top: 24px !important; max-width: 48ch; }
  .two-fronts { display: grid; grid-template-columns: 1fr 1fr; gap: 32px; }
  .two-fronts h3 { font-size: 1.7rem; font-stretch: 75%; line-height: 1.15; margin-bottom: 16px; }
  .two-fronts p { line-height: 1.6; }
  .motivations { background: var(--green); color: var(--cream); padding-block: 82px 54px; }
  .motivations-heading { display: flex; align-items: end; gap: 40px; justify-content: space-between; margin-bottom: 42px; }
  .motivations-heading p { max-width: 36ch; font-size: 17px; line-height: 1.55; }
  .motivation-controls { border: 0; padding: 0; margin: 0; min-width: 0; }
  .motivation-controls legend { font-size: 14px; margin-bottom: 14px; }
  .motivation-options { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-top: 1px solid var(--cream); }
  .motivation-options label { cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 12px; min-height: 76px; padding: 12px; font-size: clamp(1.25rem, 2.6vw, 2.1rem); font-stretch: 75%; font-weight: 750; line-height: 1.2; border-bottom: 1px solid color-mix(in srgb, var(--cream) 40%, transparent); }
  .motivation-options label:not(:nth-child(3n + 1)) { border-left: 1px solid color-mix(in srgb, var(--cream) 40%, transparent); }
  .motivation-options label:has(input:checked) { background: var(--yellow); color: var(--dark); }
  .motivation-options label:hover { background: color-mix(in srgb, var(--cream) 12%, transparent); }
  .motivation-options label:has(input:checked):hover { background: var(--yellow); }
  .motivation-options input { accent-color: var(--green); width: 18px; height: 18px; margin: 0; flex: 0 0 auto; }
  .motivation-options label:focus-within { outline: 3px solid var(--yellow); outline-offset: 5px; position: relative; z-index: 1; }
  .motivation-options input:focus-visible { outline-color: var(--dark); outline-offset: 3px; }
  .motivation-status { padding-top: 18px; font-size: 13px; color: var(--yellow); }
  .motivation-page { display: grid; grid-template-columns: 1fr 1fr; gap: 8%; padding-block: 40px 44px; border-bottom: 1px solid color-mix(in srgb, var(--cream) 35%, transparent); }
  .motivation-title h3 { font-stretch: 62%; font-size: clamp(3.4rem, 7.3vw, 6rem); font-weight: 850; letter-spacing: -.03em; line-height: 1; overflow-wrap: anywhere; }
  .motivation-title p { margin-top: 23px; font-size: clamp(1.3rem, 2vw, 1.8rem); line-height: 1.35; max-width: 27ch; color: var(--yellow); }
  .motivation-reading p + p { margin-top: 24px; }
  .motivation-reading strong { display: block; margin-bottom: 8px; }
  .motivation-footnote { max-width: 83ch; margin-top: 26px !important; font-size: 14px; }
  .no-script-note { margin-top: 16px !important; font-size: 14px; }
  .manifesto { display: grid; grid-template-columns: .8fr 1.2fr; gap: 8%; padding-block: 110px; }
  .manifesto-opening h2 { font-size: clamp(3.6rem, 5.8vw, 5.8rem); }
  .manifesto-opening p { margin-block: 30px 25px; max-width: 33ch; font-size: 18px; line-height: 1.6; }
  .manifesto-opening a { font-size: 15px; }
  .reading-hint { font-size: 13px; padding-bottom: 16px; }
  .principle { border-top: 1px solid var(--green); }
  .principle:last-child { border-bottom: 1px solid var(--green); }
  .principle summary { list-style: none; display: grid; grid-template-columns: 28px 1fr 22px; align-items: start; gap: 16px; padding-block: 22px; }
  .principle summary::-webkit-details-marker { display: none; }
  .principle-number { font-family: var(--font-mono); font-size: 11px; padding-top: 6px; }
  .principle summary h3 { font-size: clamp(1.6rem, 2.5vw, 2.15rem); font-stretch: 70%; font-weight: 750; line-height: 1.08; }
  .principle summary:hover h3 { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 5px; }
  .disclosure-sign { width: 18px; height: 18px; position: relative; margin-top: 5px; }
  .disclosure-sign::before, .disclosure-sign::after { content: ''; position: absolute; background: currentColor; top: 8px; left: 1px; width: 16px; height: 2px; }
  .disclosure-sign::after { transform: rotate(90deg); }
  .principle[open] .disclosure-sign::after { display: none; }
  .principle-reading { padding: 0 38px 28px 44px; font-size: 16px; line-height: 1.65; }
  .principle-lead { font-size: 18px; line-height: 1.45; font-weight: 650; margin-bottom: 15px !important; }
  .participation { background: var(--yellow); padding-block: 85px 70px; color: var(--dark); }
  .participation ::selection { background: var(--dark); color: var(--cream); }
  .participation-opening { display: grid; grid-template-columns: 1fr .8fr; gap: 8%; align-items: end; margin-bottom: 56px; }
  .participation-opening h2 { font-size: clamp(3.7rem, 7vw, 6rem); }
  .participation-opening p + p { margin-top: 18px; }
  .contributions { border-top: 1px solid var(--dark); }
  .contributions > div { display: grid; grid-template-columns: 1fr 1.4fr; gap: 8%; border-bottom: 1px solid color-mix(in srgb, var(--dark) 45%, transparent); padding-block: 25px; align-items: baseline; }
  .contributions dt { font-size: clamp(1.6rem, 2.7vw, 2.4rem); font-stretch: 70%; font-weight: 750; line-height: 1.15; }
  .contributions dd { max-width: 62ch; }
  .participation-note { display: grid; grid-template-columns: 1fr 1.4fr; gap: 8%; margin-top: 40px; font-size: 14px; }
  .participation-note strong { font-size: 18px; line-height: 1.5; }
  .closing { display: grid; grid-template-columns: 1fr .8fr; align-items: end; position: relative; gap: 8%; padding-block: 138px 100px; }
  .closing > img { position: absolute; width: clamp(130px, 14vw, 200px); top: 45px; right: 0; }
  .closing h2 { font-size: clamp(4.2rem, 8.2vw, 6rem); }
  .closing h2 span { text-decoration: underline; text-decoration-color: var(--yellow); text-decoration-thickness: .12em; text-underline-offset: .02em; }
  .closing-reading { max-width: 40ch; }
  .closing-reading p + p { margin-top: 20px; }
  .closing-reading .button { margin-top: 28px; }
  @media (max-width: 1000px) {
    .page-wrap { width: calc(100% - 48px); }
    .opening h1 { font-size: clamp(4.4rem, 12.7vw, 6rem); }
    .print-scene { top: 10%; bottom: 76px; }
    .scene-emblem { top: 19%; width: 77%; }
    .scene-capybara { bottom: 38px; width: 80%; left: -16%; }
    .proposal-reading { grid-template-columns: 1fr; gap: 34px; }
    .large-reading { max-width: 42ch; }
    .two-fronts { max-width: 800px; }
    .manifesto { gap: 5%; grid-template-columns: .8fr 1.2fr; }
    .principle summary { gap: 10px; grid-template-columns: 22px 1fr 18px; }
    .principle-reading { padding-inline: 32px 12px; }
    .participation-opening { align-items: start; gap: 5%; }
  }
  @media (max-width: 700px) {
    .page-wrap { width: calc(100% - 40px); }
    .opening { min-height: 0; padding-block: 32px 40px; }
    .opening-copy { width: 100%; }
    .opening h1 { font-size: clamp(4.4rem, 18.5vw, 6rem); }
    .opening-intro { max-width: 43ch; margin-top: 27px !important; font-size: 18px; }
    .opening-actions { align-items: start; flex-direction: column; gap: 18px; margin-top: 23px; }
    .print-scene { position: relative; inset: auto; height: 270px; width: min(100%, 430px); margin: 26px auto 0; }
    .scene-toucan { width: 60%; top: 0; left: -1%; }
    .scene-wind { width: 60%; top: 0; left: -1%; }
    .scene-emblem { top: 1%; right: 12%; width: 36%; }
    .scene-capybara { left: 2%; width: 51%; bottom: 36px; }
    .scene-ipe { width: 28%; right: 0; bottom: 39px; }
    .scene-caption { bottom: -5px; font-size: 11px; }
    .proposal { padding-block: 50px 60px; }
