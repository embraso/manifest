---
import { getMessages, type Locale } from '../../../i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
const messages = getMessages(locale);
const copy = messages.devs.carousel;
const principles = messages.manifesto.principles;
const topics = [
  { ...copy.topics[0], command: messages.devs.commands.manifesto, paragraphs: messages.manifesto.introduction },
  { ...copy.topics[1], command: messages.devs.commands.community, paragraphs: [messages.manifesto.invitation.introduction, messages.manifesto.invitation.body, copy.communityParagraph] },
  { ...copy.topics[2], command: messages.devs.commands.autonomy, paragraphs: copy.autonomyParagraphs },
  ...principles.map((principle, index) => ({ command: messages.devs.commands.principles[index]!, label: principle.title, title: principle.title, summary: principle.lead, paragraphs: [principle.lead, principle.body], href: '/manifesto/', link: copy.principlesLink })),
];
---

<section id="leitura-local" class="command-carousel" data-command-carousel data-state-sequence={copy.sequence} data-state-reduced={copy.reducedMotion} data-state-paced={copy.paced} data-state-pause={copy.pause} data-state-resume={copy.resume} data-announcement-template={copy.announcement} aria-labelledby="carousel-title" aria-roledescription={copy.roleDescription}>
  <div class="carousel-guide">
    <h2 id="carousel-title">{copy.heading.map((part) => part.type === 'break' ? <><br />{' '}</> : part.type === 'emphasis' || part.type === 'accent' ? <span>{part.text}</span> : part.type === 'strong' ? <strong>{part.text}</strong> : part.type === 'mark' ? <span>{part.text}</span> : part.text)}</h2>
    <p>{copy.intro}</p>
    <nav class="topic-navigation" aria-label={copy.locator}>
      <div class="topic-group">
        <h3>{copy.framingTopics}</h3>
        <ol>
          {topics.slice(0, 3).map((topic, index) => (
            <li><a href={`#leitura-${index}`} data-topic={index} aria-controls={`leitura-${index}`} aria-current={index === 0 ? 'true' : undefined}>
              <span class="topic-marker" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span><span>{topic.label}</span>
            </a></li>
          ))}
        </ol>
      </div>
      <div class="topic-group">
        <h3>{copy.principles}</h3>
        <ol>
          {topics.slice(3).map((topic, offset) => {
            const index = offset + 3;
            return <li><a href={`#leitura-${index}`} data-topic={index} aria-controls={`leitura-${index}`}>
              <span class="topic-marker" aria-hidden="true">{String(index - 2).padStart(2, '0')}</span><span>{topic.label}</span>
            </a></li>;
          })}
        </ol>
      </div>
    </nav>
  </div>
  <div class="carousel-workspace">
    <div class="workspace-heading"><span>{copy.workspace}</span><span>{copy.workspaceNotice}</span></div>
    <div class="command-line" aria-hidden="true"><span class="prompt-marker">&gt;</span><span data-typed-command>{topics[0]!.command}</span><span class="command-caret"></span></div>
    <div class="carousel-readings" data-carousel-readings role="region" aria-label={copy.selectedContent}>
      {topics.map((topic, index) => (
        <article id={`leitura-${index}`} class="topic-reading" data-reading={index} data-command={topic.command} aria-labelledby={`reading-title-${index}`}>
          <p class="reading-command">&gt; {topic.command}</p>
          <p class="reading-label">{topic.label}</p>
          <h3 id={`reading-title-${index}`}>{topic.title}</h3>
          <p class="reading-summary">{topic.summary}</p>
          <div class="topic-full-reading">{topic.paragraphs.map((paragraph) => <p>{paragraph}</p>)}</div>
          <a href={topic.href}>{topic.link}<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M5 19 19 5M5 5h14v14" /></svg></a>
        </article>
      ))}
    </div>
    <div class="carousel-controls" data-carousel-controls hidden>
      <div class="sequence-position"><span data-topic-position>01</span><span>/ {String(topics.length).padStart(2, '0')}</span><span class="sequence-state" data-carousel-state>{copy.sequence}</span></div>
      <div class="playback-controls">
        <button type="button" data-carousel-previous aria-label={copy.previous}><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M19 12H5m6 6-6-6 6-6" /></svg></button>
        <button type="button" data-carousel-pause aria-label={copy.pause} aria-pressed="false"><svg class="pause-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M8 5v14M16 5v14" /></svg><svg class="play-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m8 5 11 7-11 7V5Z" /></svg></button>
        <button type="button" data-carousel-next aria-label={copy.next}><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" /></svg></button>
      </div>
    </div>
    <div class="sequence-progress" aria-hidden="true"><span data-sequence-progress></span></div>
    <p class="carousel-status" data-carousel-announcement role="status" aria-live="polite" aria-atomic="true"></p>
  </div>
</section>

<script>
  import './controller';
</script>

<style>
  .command-carousel { --rule: #365542; --muted: #b9c9bb; grid-column: 1 / -1; display: grid; grid-template-columns: minmax(270px, .8fr) minmax(0, 1.6fr); gap: clamp(32px, 5vw, 80px); margin-top: 80px; padding-top: 48px; border-top: 1px solid var(--rule); scroll-margin-top: 32px; min-width: 0; }
  .carousel-guide { min-width: 0; }
  h2 { font: 600 clamp(1.8rem, 3.1vw, 3rem)/1.25 var(--font-mono); letter-spacing: -.02em; margin: 0 0 24px; }
  h2 span { color: var(--yellow); }
  .carousel-guide > p { color: var(--muted); font-size: 1rem; line-height: 1.8; max-width: 38ch; margin: 0 0 32px; }
  .topic-navigation { display: grid; gap: 20px; }
  .topic-group h3 { margin: 0 0 8px; color: var(--mint); font: 10px/1.6 var(--font-mono); text-transform: uppercase; letter-spacing: .035em; }
  .topic-group ol { margin: 0; padding: 0; list-style: none; border-top: 1px solid var(--rule); }
  .topic-group li { border-bottom: 1px solid var(--rule); }
  .topic-navigation a { display: grid; grid-template-columns: 24px minmax(0, 1fr); gap: 12px; align-items: center; min-height: 44px; padding: 8px; color: var(--muted); text-decoration: none; font-size: .9375rem; line-height: 1.5; }
  .topic-marker { color: var(--mint); font: 10px/1.5 var(--font-mono); }
  .topic-navigation a:hover, .topic-navigation [aria-current='true'] { color: var(--yellow); }
  .topic-navigation [aria-current='true'] .topic-marker { color: var(--yellow); }
  a:focus-visible, button:focus-visible, [tabindex]:focus-visible { outline: 3px solid var(--yellow); outline-offset: 5px; }
  .carousel-workspace { min-width: 0; align-self: start; background: #09190f; border: 1px solid var(--rule); }
  .workspace-heading { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 8px 20px; padding: 18px 28px; border-bottom: 1px solid var(--rule); color: var(--muted); font: 10px/1.6 var(--font-mono); }
  .workspace-heading > span:first-child { color: var(--mint); }
  .command-line { display: none; align-items: center; padding: 32px 28px 28px; font: 500 clamp(1.2rem, 2.2vw, 2rem)/1.5 var(--font-mono); letter-spacing: -.03em; overflow-wrap: anywhere; min-height: 106px; }
  [data-enhanced] .command-line { display: flex; }
  .prompt-marker { color: var(--mint); margin-right: 18px; flex: 0 0 auto; }
  [data-typed-command] { color: var(--yellow); }
  .command-caret { width: .55em; height: 1.15em; margin-left: 6px; background: var(--yellow); flex-shrink: 0; opacity: 0; }
  .command-carousel[data-playback='running'] .command-caret { opacity: 1; animation: caret-blink 1.1s steps(1, end) infinite; animation-play-state: running !important; }
  [data-phase='typing'][data-playback='running'] .command-caret { animation: none; }
  .carousel-readings { padding: 0 28px 32px; overflow-wrap: anywhere; }
  [data-enhanced] .carousel-readings { min-height: 330px; padding-top: 0; }
  .topic-reading { padding-top: 28px; scroll-margin-top: 20px; }
  [data-enhanced] .topic-reading { padding-top: 0; }
  .topic-reading[hidden], .carousel-controls[hidden] { display: none; }
  .reading-command { color: var(--mint); font: 12px/1.6 var(--font-mono); }
  [data-enhanced] .reading-command { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); margin: 0; }
  .reading-label { margin: 0 0 12px; color: var(--mint); font: 12px/1.6 var(--font-mono); }
  .topic-reading h3 { max-width: 20ch; margin: 0 0 20px; color: var(--cream); font: 600 clamp(1.6rem, 3.2vw, 2.4rem)/1.35 var(--font-mono); letter-spacing: -.02em; text-wrap: pretty; }
  .reading-summary, .topic-full-reading p { color: var(--muted); font-size: 1rem; line-height: 1.8; max-width: 68ch; margin: 0 0 24px; }
  [data-enhanced] .topic-full-reading { display: none; }
  .topic-reading > a { display: inline-flex; align-items: center; gap: 14px; min-height: 44px; color: var(--cream); font-size: 1rem; text-underline-offset: 4px; }
  .topic-reading > a:hover { color: var(--yellow); }
  .carousel-controls { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 16px 20px 16px 28px; border-top: 1px solid var(--rule); }
  .sequence-position { display: flex; align-items: center; gap: 9px; font: 11px/1.5 var(--font-mono); color: var(--muted); font-variant-numeric: tabular-nums; }
  [data-topic-position] { color: var(--yellow); }
  .sequence-state { font: 12px/1.5 var(--font-body); margin-left: 10px; }
  .playback-controls { display: flex; gap: 8px; }
  .playback-controls button { display: grid; place-items: center; width: 44px; height: 44px; border: 1px solid var(--rule); color: var(--cream); background: transparent; cursor: pointer; touch-action: manipulation; }
  .playback-controls button:hover:not(:disabled) { border-color: var(--yellow); color: var(--yellow); background: #10271a; }
  .playback-controls button:disabled { color: var(--muted); border-style: dashed; cursor: default; }
  .play-icon, [aria-pressed='true'] .pause-icon { display: none; }
  [aria-pressed='true'] .play-icon { display: block; }
  .sequence-progress { height: 2px; overflow: hidden; }
  .sequence-progress span { display: block; height: 100%; background: var(--yellow); transform: scaleX(0); transform-origin: left; }
  .carousel-status { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  @keyframes caret-blink { 50% { opacity: 0; } }
  @media (max-width: 1100px) {
    .command-carousel { grid-template-columns: minmax(230px, .8fr) minmax(0, 1.4fr); gap: 32px; }
    .workspace-heading, .command-line, .carousel-readings { padding-inline: 24px; }
    .sequence-state { display: none; }
  }
  @media (max-width: 760px) {
    .command-carousel { grid-row: 2; grid-template-columns: minmax(0, 1fr); margin-top: 48px; padding-top: 32px; gap: 32px; }
    .carousel-guide { display: contents; }
    .carousel-workspace { order: 1; }
    .topic-navigation { order: 2; }
    h2 { font-size: clamp(1.8rem, 6.5vw, 2.6rem); }
    h2 br { display: none; }
    .carousel-guide > p { max-width: 52ch; margin-bottom: 20px; }
    [data-enhanced] .topic-navigation { display: flex; overflow-x: auto; gap: 20px; padding: 6px 4px 12px; margin-inline: -4px; scrollbar-width: thin; scrollbar-color: var(--mint) #09190f; }
    [data-enhanced] .topic-group { flex: 0 0 auto; }
    [data-enhanced] .topic-group ol { display: flex; }
    [data-enhanced] .topic-group li { flex: 0 0 auto; border: 1px solid var(--rule); }
    [data-enhanced] .topic-navigation a { display: flex; gap: 8px; max-width: 270px; min-height: 60px; padding: 10px 12px; }
    .workspace-heading { padding: 16px 20px; font-size: 9px; }
    .command-line { padding: 24px 20px; font-size: clamp(1.2rem, 5vw, 1.75rem); min-height: 88px; }
    .carousel-readings { padding: 0 20px 24px; }
    [data-enhanced] .carousel-readings { min-height: 300px; }
    .carousel-controls { padding: 12px 16px 12px 20px; gap: 8px; }
    .playback-controls { gap: 6px; }
  }
  @media (prefers-reduced-motion: reduce) { .command-caret { animation: none !important; opacity: 0 !important; } }
  @media print {
    .command-carousel { display: block; color: #000; }
    .topic-navigation, .command-line, .carousel-controls, .sequence-progress { display: none !important; }
    .carousel-workspace { background: none; border: 0; }
    [data-enhanced] .carousel-readings { height: auto; overflow: visible; }
    .topic-reading[hidden] { display: block !important; }
    [data-enhanced] .topic-full-reading { display: block; }
    h3, .topic-reading > p:not(.reading-command), .topic-full-reading p, .topic-reading > a { color: #000; }
  }
</style>
