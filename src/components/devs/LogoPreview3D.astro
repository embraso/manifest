---
import emblem from '../../../assets/b084774a04a4acde15a270ee03518180.svg';

---

<div class="logo-preview" data-embraso-3d data-emblem-src={emblem.src}>
  <canvas aria-hidden="true"></canvas>
</div>

<style>
  .logo-preview { position: absolute; z-index: 2; inset: 0; isolation: isolate; pointer-events: none; }
  .logo-preview canvas { position: absolute; inset: 0; display: block; width: 100%; height: 100%; opacity: 0; }
  .logo-preview[data-ready='true'] canvas { opacity: 1; }
  @media (prefers-reduced-motion: reduce) { .logo-preview canvas { display: none; } }
</style>
