---
import { getMessages, type Locale } from '../../i18n';
import emblem from '../../../assets/b084774a04a4acde15a270ee03518180.svg';

interface Props { locale: Locale }
const { locale } = Astro.props;
const caption = getMessages(locale).devs.opening.faunaCaption;
---

<div class="fauna-field" data-fauna-field aria-hidden="true">
  <img data-fauna-source src={emblem.src} alt="" width="462" height="654" fetchpriority="high" />
  <canvas data-fauna-canvas></canvas>
  <span class="field-caption">{caption}</span>
</div>

<script>
  import './particles';
</script>

<style>
  .fauna-field { position: relative; align-self: stretch; min-height: 610px; isolation: isolate; }
  .fauna-field img { position: absolute; width: 86%; height: 89%; top: 2%; left: 7%; object-fit: contain; }
  .fauna-field canvas { position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0; pointer-events: none; }
  .fauna-field[data-particles='running'] canvas { opacity: 1; }
  .fauna-field[data-particles='running'] img { opacity: 0; }
  .field-caption { position: absolute; bottom: 16px; left: 0; right: 0; text-align: center; color: var(--muted); font: 10px/1.6 var(--font-mono); }
  @media (max-width: 1100px) { .fauna-field { min-height: 550px; } }
  @media (max-width: 760px) {
    .fauna-field { grid-row: 3; min-height: 0; height: 410px; margin-top: 38px; }
    .fauna-field img { width: 74%; left: 13%; height: 88%; }
  }
  @media (max-width: 380px) { .fauna-field { height: 340px; } }
  @media (prefers-reduced-motion: reduce) {
    .fauna-field canvas { display: none; }
    .fauna-field[data-particles='running'] img { opacity: 1; }
  }
</style>
